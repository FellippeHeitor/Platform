Const SFX_DIE = 8
Const SFX_WIN = 9
Const SFX_ARRIVE = 10

' glow sprite colours
Const GLOW_CYAN = 1
Const GLOW_ORANGE = 2
Const GLOW_GREEN = 3
Const GLOW_BLUE = 4
Const GLOW_PURPLE = 5
Const GLOW_YELLOW = 6

' presentation timings, in ticks
Const TELE_TICKS = 42 ' teleport: beam out, camera glides, beam in
Const POP_TICKS = 90 ' pickup label

' game states
Const ST_TITLE = 0
Const ST_PLAY = 1
Const ST_DEAD = 2
Const ST_WON = 3
Const ST_END = 4

