' Hero frames: 8x10 pixel art drawn at 2x. 0-2 run, 3 jump, 4 fall, 5 idle.
Sub initHeroSprites
    Dim body(0 To 7) As String, legs(0 To 5) As String
    Dim f As Long, r As Long, c As Long, s As String, ch As String, col As _Unsigned Long

    body(0) = "..KKKK.."
    body(1) = ".KBBBBK."
    body(2) = "KRRRRRRK"
    body(3) = "KBBBWPBK"
    body(4) = "KBBBWPBK"
    body(5) = "KBBBBBBK"
    body(6) = ".KBBBBK."
    body(7) = "..KKKK.."
    legs(0) = ".F....F.F......F"
    legs(1) = "..F..F....F..F.."
    legs(2) = "...FF......FF..."
    legs(3) = "..F.F....F...F.."
    legs(4) = "..F..F...F....F."
    legs(5) = "..F..F....F..F.."

    For f = 0 To 5
        heroImg(f) = _NewImage(16, 20, 32)
        _Dest heroImg(f)
        For r = 0 To 9
            If r < 8 Then s = body(r) Else s = Mid$(legs(f), (r - 8) * 8 + 1, 8)
            For c = 0 To 7
                ch = Mid$(s, c + 1, 1)
                Select Case ch
                    Case "K": col = _RGB32(34, 32, 52)
                    Case "B": col = _RGB32(246, 244, 236)
                    Case "R": col = _RGB32(232, 72, 72)
                    Case "W": col = _RGB32(255, 255, 255)
                    Case "P": col = _RGB32(34, 32, 52)
                    Case "F": col = _RGB32(34, 32, 52)
                    Case Else: col = 0
                End Select
                If col <> 0 Then Line (c * 2, r * 2)-Step(1, 1), col, BF
            Next
        Next
    Next
    _Dest 0
End Sub

Function mixColor~& (a As _Unsigned Long, b As _Unsigned Long, tt As Single)
    Dim t As Single
    t = tt
    If t < 0 Then t = 0
    If t > 1 Then t = 1
    mixColor~& = _RGB32(_Red32(a) + (_Red32(b) - _Red32(a)) * t, _Green32(a) + (_Green32(b) - _Green32(a)) * t, _Blue32(a) + (_Blue32(b) - _Blue32(a)) * t)
End Function

Function shade~& (c As _Unsigned Long, f As Single)
    Dim r As Single, g As Single, b As Single
    r = _Red32(c) * f: g = _Green32(c) * f: b = _Blue32(c) * f
    If r > 255 Then r = 255
    If g > 255 Then g = 255
    If b > 255 Then b = 255
    shade~& = _RGB32(r, g, b)
End Function

' Cheap deterministic noise so baked textures look the same every time.
Function hash01! (a As Long, b As Long)
    Dim v As Long
    v = (a * 73 + b * 151 + a * b * 7) Mod 997
    hash01! = v / 997
End Function

' Triangle with its tip at (cx, peakY) and a flat base at baseY (either side).
Sub fillTri (cx As Single, peakY As Single, halfW As Single, baseY As Single, c As _Unsigned Long)
    Dim y As Long, w As Single, y1 As Long, y2 As Long
    If baseY >= peakY Then y1 = Int(peakY): y2 = Int(baseY) Else y1 = Int(baseY): y2 = Int(peakY)
    For y = y1 To y2
        w = halfW * Abs(y - peakY) / (Abs(baseY - peakY) + .001)
        Line (cx - w, y)-(cx + w, y), c
    Next
End Sub

Sub bakeBackground
    Dim y As Long, i As Long, x As Single, h As Single, w As Single

    If skyImg < -1 Then _FreeImage skyImg
    skyImg = _NewImage(SW, SH, 32)
    _Dest skyImg
    For y = 0 To SH - 1
        Line (0, y)-(SW - 1, y), mixColor(th.skyTop, th.skyBottom, y / SH)
    Next
    If th.stars Then
        For i = 1 To 90
            PSet (hash01(i, 3) * SW, hash01(i, 11) * SH * .6), _RGBA32(255, 255, 255, 80 + hash01(i, 5) * 170)
        Next
    End If

    ' hill strips are 2 screens wide and wrap seamlessly
    If farImg < -1 Then _FreeImage farImg
    farImg = _NewImage(SW * 2, SH, 32)
    _Dest farImg
    For i = 0 To 9
        x = i * SW * 2 / 10 + hash01(i, 1) * 80
        h = 140 + hash01(i, 2) * 120
        w = 160 + hash01(i, 4) * 120
        fillTri x, SH - h - 40, w, SH, th.hillFar
        fillTri x + SW * 2, SH - h - 40, w, SH, th.hillFar
        fillTri x - SW * 2, SH - h - 40, w, SH, th.hillFar
    Next
    If nearImg < -1 Then _FreeImage nearImg
    nearImg = _NewImage(SW * 2, SH, 32)
    _Dest nearImg
    For i = 0 To 13
        x = i * SW * 2 / 14 + hash01(i, 7) * 60
        h = 80 + hash01(i, 8) * 90
        w = 110 + hash01(i, 9) * 90
        fillTri x, SH - h, w, SH, th.hillNear
        fillTri x + SW * 2, SH - h, w, SH, th.hillNear
        fillTri x - SW * 2, SH - h, w, SH, th.hillNear
    Next
    _Dest 0
End Sub

Sub initClouds
    Dim i As Long
    For i = 1 To 8
        clouds(i).x = Rnd * SW * 2
        clouds(i).y = 20 + Rnd * 160
        clouds(i).w = 60 + Rnd * 100
        clouds(i).speed = .1 + Rnd * .3
    Next
End Sub

' Static tiles are drawn once into a level-sized image.
Sub bakeLevel
    Dim c As Long, r As Long, t As Long, x As Long, y As Long, i As Long

    If levelImg < -1 Then _FreeImage levelImg
    levelImg = _NewImage(levelCols * TILE, SH, 32)
    rawWrites levelImg, TRUE
    _Dest levelImg
    For c = 0 To levelCols - 1
        For r = 0 To ROWS - 1
            t = tiles(c, r)
            x = c * TILE: y = r * TILE
            Select Case t
                Case T_GROUND
                    Line (x, y)-Step(TILE - 1, TILE - 1), th.ground, BF
                    For i = 0 To 2
                        Line (x + 3 + hash01(c, r * 3 + i) * 17, y + 4 + hash01(r, c * 5 + i) * 16)-Step(2, 2), th.groundDark, BF
                    Next
                    If tileAt(c - 1, r) <> T_GROUND Then Line (x, y)-Step(2, TILE - 1), shade(th.ground, 1.15), BF
                    If tileAt(c + 1, r) <> T_GROUND Then Line (x + TILE - 3, y)-Step(2, TILE - 1), th.groundDark, BF
                    If tileAt(c, r - 1) <> T_GROUND Then
                        Line (x, y)-Step(TILE - 1, 6), th.grass, BF
                        Line (x, y)-Step(TILE - 1, 1), shade(th.grass, 1.25), BF
                        Line (x, y + 7)-Step(TILE - 1, 1), shade(th.grass, .7), BF
                    End If
                Case T_PLANK
                    Line (x, y)-Step(TILE - 1, 7), _RGB32(150, 98, 54), BF
                    Line (x, y)-Step(TILE - 1, 1), _RGB32(196, 140, 84), BF
                    Line (x, y + 6)-Step(TILE - 1, 1), _RGB32(96, 60, 34), BF
                    Line (x + TILE - 2, y)-Step(1, 7), _RGB32(96, 60, 34), BF
                Case T_SPIKE
                    _PutImage (x, y), sprSpikeUp
                Case T_SPIKEDOWN
                    _PutImage (x, y), sprSpikeDown
                Case T_LAVA
                    Line (x, y)-Step(TILE - 1, TILE - 1), _RGB32(214, 64, 30), BF
                    Line (x, y + 3 + hash01(c, r) * 4)-Step(TILE - 1, 3), _RGB32(255, 168, 48), BF
                    If tileAt(c, r - 1) <> T_LAVA Then Line (x, y)-Step(TILE - 1, 2), _RGB32(255, 220, 120), BF
            End Select
        Next
    Next
    rawWrites levelImg, FALSE
    _Dest 0
End Sub

Sub render
    Dim cx As Long, ox As Long, oy As Long, i As Long, p As Single, sx As Single, sy As Single

    ox = 0: oy = 0
    If shake > 0 Then ox = (Rnd - .5) * shake * 2: oy = (Rnd - .5) * shake * 2
    cx = Int(camX)

    _PutImage (0, 0), skyImg
    drawParallax farImg, cx * .2
    drawClouds cx
    drawParallax nearImg, cx * .45
    _PutImage (ox, oy)-(ox + SW - 1, oy + SH - 1), levelImg, 0, (cx, 0)-(cx + SW - 1, SH - 1)
    drawDynamicTiles cx - ox, oy
    If gameState <> ST_TITLE And hero.alive Then
        If teleT > 0 Then
            p = teleProgress
            If p < .3 Then
                ' beam out where the hero stepped in
                sx = hero.x: sy = hero.y
                hero.x = teleFromX: hero.y = teleFromY
                drawBeam cx - ox, oy, p / .3
                drawHero cx - ox, oy, 1 - p / .3
                hero.x = sx: hero.y = sy
            ElseIf p > .75 Then
                drawBeam cx - ox, oy, 1 - (p - .75) / .25
                drawHero cx - ox, oy, (p - .75) / .25
            End If
        Else
            drawHero cx - ox, oy, 1
        End If
    End If
    drawParticles cx - ox, oy
    drawWater cx
    If gameState = ST_PLAY And popLife > 0 Then drawPopup cx

    Select Case gameState
        Case ST_TITLE: drawTitle
        Case ST_PLAY: drawHud
        Case ST_DEAD: drawHud: drawDeadScreen
        Case ST_WON: drawHud: drawWonScreen
        Case ST_END: drawEndScreen
    End Select
End Sub

Sub drawParallax (img As Long, offset As Single)
    Dim o As Long
    o = Int(offset) Mod (SW * 2)
    _PutImage (-o, 0), img
    _PutImage (SW * 2 - o, 0), img
End Sub

Sub updateClouds
    Dim i As Long
    For i = 1 To 8
        clouds(i).x = clouds(i).x - clouds(i).speed
    Next
End Sub

Sub drawClouds (cx As Long)
    Dim i As Long, x As Single, w As Single
    For i = 1 To 8
        x = clouds(i).x - cx * .3
        x = x - Int(x / (SW * 2)) * SW * 2 - 200
        w = clouds(i).w
        Line (x, clouds(i).y)-Step(w, 14), _RGBA32(255, 255, 255, 70), BF
        Line (x + w * .15, clouds(i).y - 8)-Step(w * .5, 8), _RGBA32(255, 255, 255, 70), BF
        Line (x + w * .1, clouds(i).y + 14)-Step(w * .8, 6), _RGBA32(255, 255, 255, 40), BF
    Next
End Sub

Sub drawWater (cx As Long)
    Dim x As Long, y As Single
    Line (0, WATER_Y)-(SW - 1, SH - 1), _RGBA32(_Red32(th.water), _Green32(th.water), _Blue32(th.water), 210), BF
    For x = 0 To SW Step 16
        y = WATER_Y + Sin((x + cx + frameCount * 2) / 30) * 2
        Line (x, y)-Step(9, 1), _RGBA32(255, 255, 255, 110), BF
    Next
End Sub

Sub drawDynamicTiles (cx As Long, oy As Long)
    Dim c As Long, r As Long, t As Long, x As Single, y As Single
    Dim c1 As Long, c2 As Long, b As Single, p As Single

    c1 = Int(cx / TILE) - 1
    c2 = c1 + SW \ TILE + 3
    For c = c1 To c2
        For r = 0 To ROWS - 1
            t = tileAt(c, r)
            If t >= T_GEM Then
                x = c * TILE - cx: y = r * TILE + oy
                Select Case t
                    Case T_GEM
                        If (hero.gemMask And (2 ^ gemIndex(c, r))) = 0 Or gameState = ST_TITLE Then
                            b = Sin(frameCount / 10 + c) * 3
                            p = 1 + Sin(frameCount / 9 + c) * .1
                            putCentered glow(GLOW_CYAN), x + TILE / 2, y + TILE / 2 + b, p, p
                            putCentered sprGem, x + TILE / 2, y + TILE / 2 + b, 1, 1
                            twinkle x + TILE / 2 - 4, y + TILE / 2 + b - 6, (frameCount + c * 17) Mod 90
                        End If
                    Case T_FUEL
                        If (hero.gemMask And (2 ^ gemIndex(c, r))) = 0 Or gameState = ST_TITLE Then
                            b = Sin(frameCount / 11 + c) * 2
                            p = 1 + Sin(frameCount / 9 + c) * .1
                            putCentered glow(GLOW_ORANGE), x + TILE / 2, y + TILE / 2 + b, p * .8, p * .8
                            putCentered sprFuel, x + TILE / 2, y + TILE / 2 + b, 1, 1
                        End If
                    Case T_TOGGLEA, T_TOGGLEB
                        drawToggleSpike x, y, t
                    Case T_SWITCH
                        If hero.barriersOn Or gameState = ST_TITLE Then
                            p = 1 + Sin(frameCount / 9) * .1
                            putCentered glow(GLOW_YELLOW), x + TILE / 2, y + TILE / 2, p, p
                            putCentered sprSwitchOn, x + TILE / 2, y + TILE / 2, 1, 1
                        Else
                            putCentered sprSwitchOff, x + TILE / 2, y + TILE / 2, 1, 1
                        End If
                    Case T_BARRIER
                        If hero.barriersOn Or gameState = ST_TITLE Then
                            _PutImage (x + 2, y), sprBarrier
                        Else
                            Line (x + 2, y)-Step(TILE - 5, TILE - 1), _RGBA32(255, 210, 60, 40), B
                        End If
                    Case T_TELEIN, T_TELEOUT
                        p = 1 + Sin(frameCount / 7 + c) * .12
                        putCentered glow(GLOW_PURPLE), x + TILE / 2, y + TILE / 2 - 3, p * 1.1, p * 1.3
                        putCentered sprPortal, x + TILE / 2, y + TILE / 2 - 3, 1 + (p - 1) * .3, 1 + (p - 1) * .3
                    Case T_JET, T_WINGS, T_NORMAL
                        drawModeOrb x + TILE / 2, y + TILE / 2 + Sin(frameCount / 12 + c) * 2, t
                    Case T_GOAL
                        drawGoal x, y
                End Select
            End If
        Next
    Next
End Sub

' Mode pickups, each with its own shape so they read at a glance:
' jetpack = orange orb with a pack and flame, wings = green orb with wings
' sticking out, on foot = pale blue arrow pointing down at the ground.
Sub drawModeOrb (x As Single, y As Single, t As Long)
    Dim pulse As Single, f As Single
    pulse = 1 + Sin(frameCount / 8) * .1
    Select Case t
        Case T_JET
            putCentered glow(GLOW_ORANGE), x, y, pulse, pulse
            f = .75 + Rnd * .35 ' flicker
            _PutImage (x - 4, y + 3)-(x + 4, y + 3 + 13 * f), sprFlame
            putCentered sprJet, x, y, 1, 1
        Case T_WINGS
            putCentered glow(GLOW_GREEN), x, y, pulse, pulse
            f = .55 + .45 * (.5 + .5 * Sin(frameCount / 5)) ' flap
            _PutImage (x - 22, y - 1 - 8 * f)-(x - 5, y - 1 + 8 * f), sprWingL
            _PutImage (x + 5, y - 1 - 8 * f)-(x + 22, y - 1 + 8 * f), sprWingR
            putCentered sprWingsBody, x, y, 1, 1
        Case Else
            putCentered glow(GLOW_BLUE), x, y, pulse, pulse
            putCentered sprFoot, x, y, 1, 1
    End Select
End Sub

' Toggle spikes slide: they rise just before they become dangerous and sink
' just after they stop being dangerous, so what you see is never safer than
' what the physics does.
Sub drawToggleSpike (x As Single, y As Single, t As Long)
    Dim shift As Long
    shift = Int((1 - toggleVisual(t)) * 18)
    If shift < 18 Then _PutImage (x, y + shift)-(x + TILE - 1, y + TILE - 1), sprSpikeUp, 0, (0, 0)-(TILE - 1, TILE - 1 - shift)
    ' the base plate always shows; the spikes sink into it
    _PutImage (x, y + 20)-(x + TILE - 1, y + TILE - 1), sprSpikeUp, 0, (0, 20)-(TILE - 1, TILE - 1)
End Sub

Function toggleVisual! (t As Long)
    Const MOVE = 8
    Dim ph As Long, rel As Long, period As Long
    period = TOGGLE_TICKS * 2
    ph = simTick Mod period
    If t = T_TOGGLEA Then rel = ph Else rel = (ph + TOGGLE_TICKS) Mod period
    If rel < TOGGLE_TICKS Then
        toggleVisual! = 1 ' dangerous
    ElseIf rel < TOGGLE_TICKS + MOVE Then
        toggleVisual! = 1 - (rel - TOGGLE_TICKS) / MOVE ' sinking, already safe
    ElseIf rel >= period - MOVE Then
        toggleVisual! = (rel - (period - MOVE)) / MOVE ' rising, not dangerous yet
    Else
        toggleVisual! = 0
    End If
End Function

' A brief four-point sparkle; age counts up, visible for the first 12.
Sub twinkle (x As Single, y As Single, age As Long)
    Dim a As Long, s As Single
    If age >= 12 Then Exit Sub
    s = Sin(age / 12 * 3.1416)
    a = 230 * s
    Line (x - 4 * s, y)-(x + 4 * s, y), _RGBA32(255, 255, 255, a)
    Line (x, y - 4 * s)-(x, y + 4 * s), _RGBA32(255, 255, 255, a)
End Sub

' Draw img centred on (x, y), scaled by sx, sy.
Sub putCentered (img As Long, x As Single, y As Single, sx As Single, sy As Single)
    Dim w As Single, h As Single
    w = _Width(img) * sx: h = _Height(img) * sy
    If w < 1 Or h < 1 Then Exit Sub
    _PutImage (x - w / 2, y - h / 2)-(x + w / 2 - 1, y + h / 2 - 1), img
End Sub

Sub drawGoal (x As Single, y As Single)
    Dim i As Long, w As Single, fy As Single
    Line (x + 2, y - 70)-Step(3, 70 + TILE - 1), _RGB32(240, 240, 240), BF
    Line (x + 2, y - 70)-Step(3, 70 + TILE - 1), _RGB32(60, 60, 80), B
    For i = 0 To 30
        fy = y - 68 + Sin(frameCount / 6 - i / 5) * 2
        If ((i \ 6) Mod 2) = 0 Then
            Line (x + 6 + i, fy)-Step(0, 9), _RGB32(30, 30, 40)
            Line (x + 6 + i, fy + 10)-Step(0, 9), _RGB32(250, 250, 250)
        Else
            Line (x + 6 + i, fy)-Step(0, 9), _RGB32(250, 250, 250)
            Line (x + 6 + i, fy + 10)-Step(0, 9), _RGB32(30, 30, 40)
        End If
    Next
End Sub

' vis < 1 squeezes the hero into a thin, tall sliver (used by teleports).
Sub drawHero (cx As Long, oy As Long, vis As Single)
    Dim f As Long, x As Single, y As Single, w As Single, h As Single
    Dim sy As Single, r As Long, c As Long, sx1 As Single, sx2 As Single

    ' shadow on the first floor below the hero
    sx1 = hero.x + 2: sx2 = hero.x + HERO_W - 2
    For r = Int((hero.y + HERO_H) / TILE) To ROWS - 1
        If r >= 0 Then
            c = Int((hero.x + HERO_W / 2) / TILE)
            If isSolid(hero, c, r) Or tileAt(c, r) = T_PLANK Then
                sy = r * TILE
                Line (sx1 - cx, sy + 2 + oy)-(sx2 - cx, sy + 4 + oy), _RGBA32(0, 0, 0, 60), BF
                Exit For
            End If
        End If
    Next

    If hero.grounded Then
        If gameState = ST_PLAY Then f = (frameCount \ 5) Mod 3 Else f = 5
    ElseIf hero.yv < 0 Then
        f = 3
    Else
        f = 4
    End If

    ' squash > 0 = landing (wide and short), < 0 = take-off (tall and thin)
    w = 16 * (1 + squash * .35) * vis
    h = 20 * (1 - squash * .3) * (1 + (1 - vis) * .8)
    x = hero.x + HERO_W / 2 - w / 2 - cx
    y = hero.y + HERO_H - h + oy
    If w >= 1 Then _PutImage (x, y)-(x + w - 1, y + h - 1), heroImg(f)
    If vis < 1 Then Exit Sub

    ' mode marker and spare air jumps
    If hero.mode = MODE_JET Then
        Line (x - 3, y + 8)-Step(3, 8), _RGB32(120, 120, 140), BF
        If hero.thrust Then Line (x - 3, y + 17)-Step(3, 3 + Rnd * 4), _RGB32(255, 170, 60), BF
    ElseIf hero.mode = MODE_WINGS Then
        Line (x - 6, y + 6 + (frameCount Mod 10 < 5) * 2)-Step(5, 3), _RGB32(255, 255, 255), BF
    End If
    For c = 1 To hero.airJumps
        putCentered sprGem, x + w / 2 - (hero.airJumps - 1) * 6 + (c - 1) * 12, y - 9, .45, .45
    Next
    ' fuel gauge: a bar that stretches past full when you carry extra
    If hero.mode = MODE_JET Then
        Line (x + w / 2 - 13, y - 18)-Step(26 * fuelBarScale(hero.fuel), 4), _RGB32(50, 30, 24), BF
        Line (x + w / 2 - 12, y - 17)-Step(26 * fuelBarScale(hero.fuel) - 2, 2), _RGB32(70, 44, 36), BF
        If hero.fuel * 26 / JET_FUEL > 2 Then Line (x + w / 2 - 12, y - 17)-Step(26 * hero.fuel / JET_FUEL - 2, 2), _RGB32(255, 160, 60), BF
    End If
    ' wings timer: a shrinking bar that blinks near the end
    If hero.mode = MODE_WINGS Then
        If hero.wingTicks > 40 Or (frameCount \ 4) Mod 2 = 0 Then
            Line (x + w / 2 - 13, y - 18)-Step(26, 4), _RGB32(30, 50, 40), BF
            Line (x + w / 2 - 12, y - 17)-Step(24 * hero.wingTicks / WING_TICKS, 2), _RGB32(150, 250, 170), BF
        End If
    End If
End Sub

' A column of light on the hero; strength 0..1.
Sub drawBeam (cx As Long, oy As Long, strength As Single)
    Dim x As Single, top As Single, bot As Single
    x = hero.x + HERO_W / 2 - cx
    bot = hero.y + HERO_H + oy
    top = bot - 90
    Line (x - 9, top)-(x + 9, bot), _RGBA32(220, 120, 255, 70 * strength), BF
    Line (x - 4, top)-(x + 4, bot), _RGBA32(255, 230, 255, 120 * strength), BF
End Sub

Sub drawPopup (cx As Long)
    Dim x As Single, y As Single, a As Long, age As Long, w As Single
    age = POP_TICKS - popLife
    a = 255
    If age < 6 Then a = 255 * age / 6
    If popLife < 25 Then a = 255 * popLife / 25
    x = hero.x + HERO_W / 2 - cx
    y = hero.y - 40 - age * .3
    If y < 60 Then y = 60
    w = _PrintWidth(popHint) / 2 + 4
    If w < _PrintWidth(popText) + 4 Then w = _PrintWidth(popText) + 4
    If x < w Then x = w
    If x > SW - w Then x = SW - w
    bigText popText, x, y, 2, _RGBA32(_Red32(popColor), _Green32(popColor), _Blue32(popColor), a)
    If popHint <> "" Then
        putText popHint, x - _PrintWidth(popHint) / 2 + 1, y + 19, 1, _RGBA32(30, 26, 46, a)
        putText popHint, x - _PrintWidth(popHint) / 2, y + 18, 1, _RGBA32(255, 255, 255, a)
    End If
End Sub

Sub sparkle (x As Single, y As Single)
    spawnParticle x + (Rnd - .5) * 16, y + (Rnd - .5) * 24, (Rnd - .5) * .6, -Rnd * 1.5 - .5, 18, 2, _RGB32(240, 190, 255)
End Sub

'=============================================================================
' SPRITES
' Spikes and pickups are drawn once at startup into small images with smooth
' edges: every pixel measures how far it is from each shape's edge and the
' layers are blended by hand. Each frame then only needs _PutImage.
'=============================================================================

Sub initSprites
    sprSpikeUp = makeSpike(FALSE)
    sprSpikeDown = makeSpike(TRUE)
    sprGem = makeGem
    sprJet = makeJetOrb
    sprFlame = makeFlame
    sprWingsBody = makeWingsOrb
    sprWingL = makeWing(FALSE)
    sprWingR = makeWing(TRUE)
    sprFoot = makeFootOrb
    sprSwitchOn = makeSwitch(TRUE)
    sprSwitchOff = makeSwitch(FALSE)
    sprPortal = makePortal
    sprBarrier = makeBarrier
    sprFuel = makeFuel
    glow(GLOW_CYAN) = makeGlow(_RGB32(120, 230, 255))
    glow(GLOW_ORANGE) = makeGlow(_RGB32(255, 150, 60))
    glow(GLOW_GREEN) = makeGlow(_RGB32(130, 240, 150))
    glow(GLOW_BLUE) = makeGlow(_RGB32(170, 210, 255))
    glow(GLOW_PURPLE) = makeGlow(_RGB32(210, 120, 255))
    glow(GLOW_YELLOW) = makeGlow(_RGB32(255, 220, 90))

    Dim i As Long
    rawWrites sprSpikeUp, FALSE: rawWrites sprSpikeDown, FALSE: rawWrites sprGem, FALSE
    rawWrites sprJet, FALSE: rawWrites sprFlame, FALSE: rawWrites sprWingsBody, FALSE
    rawWrites sprWingL, FALSE: rawWrites sprWingR, FALSE: rawWrites sprFoot, FALSE
    rawWrites sprSwitchOn, FALSE: rawWrites sprSwitchOff, FALSE: rawWrites sprPortal, FALSE: rawWrites sprBarrier, FALSE: rawWrites sprFuel, FALSE
    For i = 1 To 6: rawWrites glow(i), FALSE: Next
End Sub

' QB64 blends semi-transparent pixels into an empty image as if it were
' black, which leaves dark fringes on soft edges, so while building an image
' we write pixels as-is, then switch blending back on (QB64 uses the source
' image's setting when it _PutImage's it). The browser canvas in QBJS gets
' this right by itself, so QBJS skips it.
Sub rawWrites (img As Long, raw As Long)
$If WEB Then
$Else
    If raw Then _DontBlend img Else _Blend img
$End If
End Sub

Function newSprite& (w As Long, h As Long)
    Dim img As Long
    img = _NewImage(w, h, 32)
    rawWrites img, TRUE
    _Dest img
    newSprite& = img
End Function

'--- per-pixel blending: pxBegin, then pxLayer from back to front, then pxEnd

Sub pxBegin
    accR = 0: accG = 0: accB = 0: accA = 0
End Sub

' Paint colour c over the current pixel with coverage cv (0..1).
Sub pxLayer (c As _Unsigned Long, cv As Single)
    Dim a As Single, keep As Single, outA As Single
    If cv <= 0 Then Exit Sub
    a = _Alpha32(c) / 255 * cv
    If a > 1 Then a = 1
    keep = accA * (1 - a)
    outA = a + keep
    If outA <= 0 Then Exit Sub
    accR = (_Red32(c) * a + accR * keep) / outA
    accG = (_Green32(c) * a + accG * keep) / outA
    accB = (_Blue32(c) * a + accB * keep) / outA
    accA = outA
End Sub

Sub pxEnd (x As Long, y As Long)
    If accA > .004 Then PSet (x, y), _RGBA32(accR, accG, accB, accA * 255)
End Sub

' How much of a pixel a shape covers, from the signed distance to its edge
' (negative = inside). This one-pixel ramp is what makes the edges smooth.
Function cov! (d As Single)
    If d <= -.5 Then
        cov! = 1
    ElseIf d >= .5 Then
        cov! = 0
    Else
        cov! = .5 - d
    End If
End Function

'--- signed distances to shapes

Function sdCircle! (px As Single, py As Single, cx As Single, cy As Single, r As Single)
    sdCircle! = Sqr((px - cx) * (px - cx) + (py - cy) * (py - cy)) - r
End Function

' Box centred on (cx, cy), half sizes hw x hh, corners rounded by rad.
Function sdBox! (px As Single, py As Single, cx As Single, cy As Single, hw As Single, hh As Single, rad As Single)
    Dim qx As Single, qy As Single, ox As Single, oy As Single, m As Single
    qx = Abs(px - cx) - hw + rad: qy = Abs(py - cy) - hh + rad
    ox = qx: oy = qy
    If ox < 0 Then ox = 0
    If oy < 0 Then oy = 0
    m = qx
    If qy > m Then m = qy
    If m > 0 Then m = 0
    sdBox! = Sqr(ox * ox + oy * oy) + m - rad
End Function

' Ellipse starting at (ax, ay) along angle ang, length ln, half-thickness th.
Function sdFeather! (px As Single, py As Single, ax As Single, ay As Single, ang As Single, ln As Single, th As Single)
    Dim dx As Single, dy As Single, mx As Single, my As Single, u As Single, v As Single
    dx = Cos(ang): dy = Sin(ang)
    mx = px - (ax + dx * ln / 2): my = py - (ay + dy * ln / 2)
    u = (mx * dx + my * dy) / (ln / 2)
    v = (-mx * dy + my * dx) / th
    sdFeather! = (Sqr(u * u + v * v) - 1) * th
End Function

Sub setPoly3 (x1 As Single, y1 As Single, x2 As Single, y2 As Single, x3 As Single, y3 As Single)
    polyN = 3
    polyX(1) = x1: polyY(1) = y1: polyX(2) = x2: polyY(2) = y2: polyX(3) = x3: polyY(3) = y3
    fixPolyOrient
End Sub

Sub setPoly5 (x1 As Single, y1 As Single, x2 As Single, y2 As Single, x3 As Single, y3 As Single, x4 As Single, y4 As Single, x5 As Single, y5 As Single)
    polyN = 5
    polyX(1) = x1: polyY(1) = y1: polyX(2) = x2: polyY(2) = y2: polyX(3) = x3: polyY(3) = y3
    polyX(4) = x4: polyY(4) = y4: polyX(5) = x5: polyY(5) = y5
    fixPolyOrient
End Sub

' Make sdPoly negative inside, whichever way round the points were given.
Sub fixPolyOrient
    Dim i As Long, cx As Single, cy As Single
    For i = 1 To polyN
        cx = cx + polyX(i): cy = cy + polyY(i)
    Next
    polyOrient = 1
    If sdPoly(cx / polyN, cy / polyN) > 0 Then polyOrient = -1
End Sub

' Distance to a convex polygon (exact inside and near the edges, which is
' all the edge smoothing needs).
Function sdPoly! (px As Single, py As Single)
    Dim i As Long, j As Long, ex As Single, ey As Single, d As Single, m As Single
    m = -1E+9
    For i = 1 To polyN
        j = i Mod polyN + 1
        ex = polyX(j) - polyX(i): ey = polyY(j) - polyY(i)
        d = ((px - polyX(i)) * ey - (py - polyY(i)) * ex) / Sqr(ex * ex + ey * ey) * polyOrient
        If d > m Then m = d
    Next
    sdPoly! = m
End Function

' Shading for a ball of radius r centred at (cx, cy), lit from the top left.
Function sphereShade~& (c As _Unsigned Long, px As Single, py As Single, cx As Single, cy As Single, r As Single)
    Dim nx As Single, ny As Single, t As Single, lam As Single, f As Single, spec As Single
    Dim rr As Single, gg As Single, bb As Single
    nx = (px - cx) / r: ny = (py - cy) / r
    t = 1 - nx * nx - ny * ny
    If t < 0 Then t = 0
    lam = -.45 * nx - .55 * ny + .7 * Sqr(t)
    If lam < 0 Then lam = 0
    f = .5 + .65 * lam
    spec = (lam ^ 20) * .8
    rr = _Red32(c) * f + 255 * spec: gg = _Green32(c) * f + 255 * spec: bb = _Blue32(c) * f + 255 * spec
    If rr > 255 Then rr = 255
    If gg > 255 Then gg = 255
    If bb > 255 Then bb = 255
    sphereShade~& = _RGB32(rr, gg, bb)
End Function

'--- the sprites

' Steel spikes for one tile: a big spike with two small ones behind it, on a
' base plate, lit from the left. flip = the hanging version.
Function makeSpike& (flip As Long)
    Dim img As Long, px As Long, py As Long, X As Single, Y As Single, d As Single, t As Single
    Dim ink As _Unsigned Long, lit As _Unsigned Long, shd As _Unsigned Long
    ink = _RGB32(36, 36, 52)
    img = newSprite(TILE, TILE)
    For py = 0 To TILE - 1
        For px = 0 To TILE - 1
            X = px + .5: Y = py + .5
            If flip Then Y = TILE - Y
            t = (Y - 4) / 18
            lit = mixColor(_RGB32(238, 242, 250), _RGB32(170, 176, 198), t)
            shd = mixColor(_RGB32(150, 156, 180), _RGB32(92, 96, 120), t)
            pxBegin
            setPoly3 5, 11, 1, 22.5, 9.5, 22.5
            d = sdPoly(X, Y)
            pxLayer ink, cov(d)
            If X < 5 Then pxLayer lit, cov(d + 1) Else pxLayer shd, cov(d + 1)
            setPoly3 20, 11, 15.5, 22.5, 24, 22.5
            d = sdPoly(X, Y)
            pxLayer ink, cov(d)
            If X < 20 Then pxLayer lit, cov(d + 1) Else pxLayer shd, cov(d + 1)
            setPoly3 12.5, 2.5, 4.5, 22.5, 20.5, 22.5
            d = sdPoly(X, Y)
            pxLayer ink, cov(d)
            If X < 12.5 Then pxLayer lit, cov(d + 1) Else pxLayer shd, cov(d + 1)
            pxLayer _RGBA32(255, 255, 255, 70), cov(Abs(X - 12.5) - .4) * cov(d + 2)
            pxLayer _RGBA32(255, 255, 255, 230), cov(sdCircle(X, Y, 11.3, 8.5, .9))
            d = sdBox(X, Y, 12.5, 23, 11.5, 2, 1)
            pxLayer ink, cov(d)
            pxLayer mixColor(_RGB32(128, 134, 156), _RGB32(76, 80, 100), (Y - 21.5) / 3), cov(d + 1)
            pxEnd px, py
        Next
    Next
    _Dest 0
    makeSpike& = img
End Function

' Cut diamond: lighter crown facets on top, darker pavilion below.
Function makeGem&
    Dim img As Long, px As Long, py As Long, X As Single, Y As Single, d As Single
    Dim c As _Unsigned Long, xl As Single, xr As Single
    img = newSprite(20, 24)
    For py = 0 To 23
        For px = 0 To 19
            X = px + .5: Y = py + .5
            pxBegin
            setPoly5 6, 2, 14, 2, 19, 8.5, 10, 22.5, 1, 8.5
            d = sdPoly(X, Y)
            pxLayer _RGB32(24, 64, 112), cov(d)
            If Y < 8.5 Then
                If X < 6.5 Then
                    c = _RGB32(214, 250, 255)
                ElseIf X > 13.5 Then
                    c = _RGB32(112, 202, 246)
                Else
                    c = _RGB32(172, 238, 255)
                End If
            Else
                xl = 5 + (Y - 8.5) / 14 * 5: xr = 15 - (Y - 8.5) / 14 * 5
                If X < xl Then
                    c = _RGB32(96, 192, 242)
                ElseIf X > xr Then
                    c = _RGB32(40, 132, 210)
                Else
                    c = _RGB32(70, 166, 232)
                End If
            End If
            pxLayer c, cov(d + 1)
            pxLayer _RGBA32(255, 255, 255, 110), cov(Abs(Y - 8.5) - .5) * cov(d + 1.5)
            pxLayer _RGBA32(255, 255, 255, 240), cov(sdCircle(X, Y, 6.5, 5, 1.2))
            pxEnd px, py
        Next
    Next
    _Dest 0
    makeGem& = img
End Function

' Soft round glow, strongest in the middle.
Function makeGlow& (c As _Unsigned Long)
    Dim img As Long, px As Long, py As Long, d As Single
    img = newSprite(48, 48)
    For py = 0 To 47
        For px = 0 To 47
            d = Sqr((px + .5 - 24) * (px + .5 - 24) + (py + .5 - 24) * (py + .5 - 24)) / 24
            If d < 1 Then
                pxBegin
                pxLayer c, (1 - d) * (1 - d) * .5
                pxEnd px, py
            End If
        Next
    Next
    _Dest 0
    makeGlow& = img
End Function

Function makeJetOrb&
    Dim img As Long, px As Long, py As Long, X As Single, Y As Single, d As Single
    img = newSprite(24, 24)
    For py = 0 To 23
        For px = 0 To 23
            X = px + .5: Y = py + .5
            pxBegin
            d = sdCircle(X, Y, 12, 12, 9.5)
            pxLayer _RGB32(96, 40, 18), cov(d)
            pxLayer sphereShade(_RGB32(255, 138, 48), X, Y, 12, 12, 9.5), cov(d + 1)
            d = sdBox(X, Y, 12, 11, 3.5, 4.5, 1.5)
            pxLayer _RGB32(40, 40, 58), cov(d)
            pxLayer mixColor(_RGB32(200, 202, 220), _RGB32(110, 112, 134), (X - 8.5) / 7), cov(d + 1)
            d = sdBox(X, Y, 12, 16.5, 2, 1.2, .5)
            pxLayer _RGB32(40, 40, 58), cov(d)
            pxLayer _RGB32(90, 92, 112), cov(d + 1)
            pxEnd px, py
        Next
    Next
    _Dest 0
    makeJetOrb& = img
End Function

' Teardrop flame, yellow at the top fading to orange.
Function makeFlame&
    Dim img As Long, px As Long, py As Long, X As Single, Y As Single, d As Single, d2 As Single
    img = newSprite(8, 13)
    For py = 0 To 12
        For px = 0 To 7
            X = px + .5: Y = py + .5
            pxBegin
            d = sdCircle(X, Y, 4, 4, 3.2)
            setPoly3 1, 4, 7, 4, 4, 12.5
            d2 = sdPoly(X, Y)
            If d2 < d Then d = d2
            pxLayer mixColor(_RGB32(255, 250, 200), _RGB32(255, 120, 30), Y / 12), cov(d) * .95
            pxEnd px, py
        Next
    Next
    _Dest 0
    makeFlame& = img
End Function

Function makeWingsOrb&
    Dim img As Long, px As Long, py As Long, X As Single, Y As Single, d As Single
    img = newSprite(22, 22)
    For py = 0 To 21
        For px = 0 To 21
            X = px + .5: Y = py + .5
            pxBegin
            d = sdCircle(X, Y, 11, 11, 8.5)
            pxLayer _RGB32(20, 72, 36), cov(d)
            pxLayer sphereShade(_RGB32(92, 214, 116), X, Y, 11, 11, 8.5), cov(d + 1)
            pxEnd px, py
        Next
    Next
    _Dest 0
    makeWingsOrb& = img
End Function

' Three feathers fanning out from the orb; mirror = the right-hand wing.
Function makeWing& (mirror As Long)
    Dim img As Long, px As Long, py As Long, X As Single, Y As Single, d As Single, i As Long
    Dim ang As Single, ln As Single, e As Single
    img = newSprite(18, 16)
    For py = 0 To 15
        For px = 0 To 17
            X = px + .5: Y = py + .5
            If mirror Then X = 18 - X
            d = 1E+9
            For i = 0 To 2
                ang = 3.1416 + (.55 - i * .45) ' pointing left, fanned out
                ln = 16.5 - i * 3
                e = sdFeather(X, Y, 17, 8, ang, ln, 2.3)
                If e < d Then d = e
            Next
            pxBegin
            pxLayer _RGB32(118, 128, 160), cov(d)
            pxLayer mixColor(_RGB32(255, 255, 255), _RGB32(200, 212, 236), (17 - X) / 17), cov(d + 1)
            pxEnd px, py
        Next
    Next
    _Dest 0
    makeWing& = img
End Function

' Rounded arrow pointing down at a little ground bar.
Function makeFootOrb&
    Dim img As Long, px As Long, py As Long, X As Single, Y As Single, d As Single
    img = newSprite(22, 26)
    For py = 0 To 25
        For px = 0 To 21
            X = px + .5: Y = py + .5
            pxBegin
            setPoly3 4.5, 5, 17.5, 5, 11, 15.5
            d = sdPoly(X, Y) - 1.8
            pxLayer _RGB32(40, 52, 88), cov(d)
            pxLayer mixColor(_RGB32(228, 240, 255), _RGB32(128, 178, 242), (Y - 3) / 14), cov(d + 1)
            pxLayer _RGBA32(255, 255, 255, 120), cov(sdBox(X, Y, 11, 5.2, 5.5, .6, .6))
            d = sdBox(X, Y, 11, 22, 8.5, 1.8, .9)
            pxLayer _RGB32(40, 52, 88), cov(d)
            pxLayer _RGB32(124, 146, 188), cov(d + 1)
            pxEnd px, py
        Next
    Next
    _Dest 0
    makeFootOrb& = img
End Function

Function makeSwitch& (onState As Long)
    Dim img As Long, px As Long, py As Long, X As Single, Y As Single, d As Single
    img = newSprite(19, 19)
    For py = 0 To 18
        For px = 0 To 18
            X = px + .5: Y = py + .5
            pxBegin
            If onState Then
                d = sdBox(X, Y, 9.5, 9.5, 7.5, 7.5, 3)
                pxLayer _RGB32(112, 72, 12), cov(d)
                pxLayer mixColor(_RGB32(255, 234, 120), _RGB32(232, 162, 36), (Y - 2) / 15), cov(d + 1)
                d = sdCircle(X, Y, 9.5, 9.5, 3.5)
                pxLayer _RGB32(140, 92, 20), cov(d)
                pxLayer _RGB32(255, 250, 216), cov(d + 1)
            Else
                d = sdBox(X, Y, 9.5, 15, 7.5, 3, 1.5)
                pxLayer _RGB32(90, 60, 14), cov(d)
                pxLayer mixColor(_RGB32(186, 146, 70), _RGB32(140, 104, 44), (Y - 12) / 6), cov(d + 1)
            End If
            pxEnd px, py
        Next
    Next
    _Dest 0
    makeSwitch& = img
End Function

' Fuel can: red jerrycan with a cap and a pale label band.
Function makeFuel&
    Dim img As Long, px As Long, py As Long, X As Single, Y As Single, d As Single
    img = newSprite(16, 20)
    For py = 0 To 19
        For px = 0 To 15
            X = px + .5: Y = py + .5
            pxBegin
            d = sdBox(X, Y, 10, 3, 2.2, 2, .8) ' cap
            pxLayer _RGB32(50, 40, 40), cov(d)
            pxLayer _RGB32(170, 170, 186), cov(d + 1)
            d = sdBox(X, Y, 8, 11.5, 6.5, 7.5, 2.2) ' body
            pxLayer _RGB32(80, 20, 18), cov(d)
            pxLayer mixColor(_RGB32(255, 104, 80), _RGB32(196, 40, 32), (X - 2) / 12), cov(d + 1)
            pxLayer _RGBA32(255, 236, 200, 220), cov(sdBox(X, Y, 8, 12, 4.5, 2, .8))
            pxLayer _RGBA32(255, 255, 255, 120), cov(sdBox(X, Y, 3.6, 10, .7, 4, .5))
            pxEnd px, py
        Next
    Next
    _Dest 0
    makeFuel& = img
End Function

' Barrier block: rounded, with soft yellow and dark hazard stripes.
Function makeBarrier&
    Dim img As Long, px As Long, py As Long, X As Single, Y As Single, d As Single, v As Single
    img = newSprite(21, TILE)
    For py = 0 To TILE - 1
        For px = 0 To 20
            X = px + .5: Y = py + .5
            pxBegin
            d = sdBox(X, Y, 10.5, 12.5, 10, 12, 2.5)
            pxLayer _RGB32(100, 66, 12), cov(d)
            pxLayer mixColor(_RGB32(255, 222, 96), _RGB32(232, 160, 34), Y / TILE), cov(d + 1)
            v = Sin((X + Y) * 3.1416 / 5) * 3 + .5 ' stripes with soft edges
            If v > 1 Then v = 1
            If v > 0 Then pxLayer _RGBA32(70, 52, 24, 170), v * cov(d + 3)
            pxLayer _RGBA32(255, 255, 230, 140), cov(Abs(d + 2) - .5) * cov(Y - 12)
            pxEnd px, py
        Next
    Next
    _Dest 0
    makeBarrier& = img
End Function

' Upright ring, lit on its upper left.
Function makePortal&
    Dim img As Long, px As Long, py As Long, X As Single, Y As Single, d As Single
    Dim qx As Single, qy As Single, e As Single, h As Single
    img = newSprite(22, 32)
    For py = 0 To 31
        For px = 0 To 21
            X = px + .5: Y = py + .5
            qx = (X - 11) / 8: qy = (Y - 16) / 13
            e = (Sqr(qx * qx + qy * qy) - 1) * 9
            d = Abs(e) - 1.8
            h = .5 + .5 * Cos(_Atan2(Y - 16, X - 11) + 2.4)
            pxBegin
            pxLayer _RGBA32(230, 170, 255, 60), cov(e)
            pxLayer _RGB32(84, 26, 140), cov(d)
            pxLayer mixColor(_RGB32(150, 70, 232), _RGB32(255, 214, 255), h), cov(d + .9)
            pxEnd px, py
        Next
    Next
    _Dest 0
    makePortal& = img
End Function

Function fuelBarScale! (f As Long)
    If f > JET_FUEL Then fuelBarScale! = f / JET_FUEL Else fuelBarScale! = 1
End Function

'--- particles

Sub spawnParticle (x As Single, y As Single, xv As Single, yv As Single, life As Single, size As Single, c As _Unsigned Long)
    Dim i As Long
    For i = 1 To UBound(particles)
        If particles(i).life <= 0 Then
            particles(i).x = x: particles(i).y = y
            particles(i).xv = xv: particles(i).yv = yv
            particles(i).life = life: particles(i).maxLife = life
            particles(i).size = size: particles(i).c = c
            Exit Sub
        End If
    Next
End Sub

Sub burst (x As Single, y As Single, n As Long, c As _Unsigned Long)
    Dim i As Long, a As Single, s As Single
    For i = 1 To n
        a = Rnd * 6.283: s = 1 + Rnd * 5
        spawnParticle x, y, Cos(a) * s, Sin(a) * s - 2, 30 + Rnd * 30, 2 + Rnd * 3, c
    Next
End Sub

Sub dust (x As Single, y As Single, n As Long)
    Dim i As Long
    For i = 1 To n
        spawnParticle x + (Rnd - .5) * 10, y - 2, (Rnd - .7) * 2, -Rnd * 1.2, 15 + Rnd * 10, 2 + Rnd * 2, _RGBA32(255, 255, 255, 180)
    Next
End Sub

Sub ring (x As Single, y As Single, c As _Unsigned Long)
    Dim i As Long, a As Single
    For i = 0 To 11
        a = i * 6.283 / 12
        spawnParticle x, y, Cos(a) * 3, Sin(a) * 3, 20, 3, c
    Next
End Sub

Sub updateParticles
    Dim i As Long
    For i = 1 To UBound(particles)
        If particles(i).life > 0 Then
            particles(i).x = particles(i).x + particles(i).xv
            particles(i).y = particles(i).y + particles(i).yv
            particles(i).yv = particles(i).yv + .15
            particles(i).xv = particles(i).xv * .97
            particles(i).life = particles(i).life - 1
        End If
    Next
End Sub

Sub drawParticles (cx As Long, oy As Long)
    Dim i As Long, s As Single, a As Single, c As _Unsigned Long
    For i = 1 To UBound(particles)
        If particles(i).life > 0 Then
            a = particles(i).life / particles(i).maxLife
            c = particles(i).c
            s = particles(i).size
            Line (particles(i).x - cx - s / 2, particles(i).y + oy - s / 2)-Step(s, s), _RGBA32(_Red32(c), _Green32(c), _Blue32(c), _Alpha32(c) * a), BF
        End If
    Next
End Sub

'--- text and screens

' Scaled text: print into a small image, then stretch it onto the screen.
Sub bigText (s As String, cx As Single, cy As Single, scale As Single, c As _Unsigned Long)
    Dim x As Single, y As Single, w As Long, h As Long
    If Len(s) = 0 Then Exit Sub
    w = _PrintWidth(s): h = _FontHeight
    x = cx - w * scale / 2: y = cy - h * scale / 2
    putText s, x + scale, y + scale, scale, _RGBA32(30, 26, 46, _Alpha32(c))
    putText s, x, y, scale, c
End Sub

Sub putText (s As String, x As Single, y As Single, scale As Single, c As _Unsigned Long)
    Dim img As Long, w As Long, h As Long
    w = _PrintWidth(s): h = _FontHeight
    img = _NewImage(w, h, 32)
    _Dest img
    _PrintMode _KeepBackground
    Color c
    _PrintString (0, 0), s
    _Dest 0
    _PutImage (x, y)-(x + w * scale - 1, y + h * scale - 1), img
    _FreeImage img
End Sub

Sub textAt (s As String, x As Single, y As Single, c As _Unsigned Long)
    _PrintMode _KeepBackground
    Color _RGBA32(0, 0, 0, 120)
    _PrintString (x + 1, y + 1), s
    Color c
    _PrintString (x, y), s
End Sub

Sub centerText (s As String, y As Single, c As _Unsigned Long)
    textAt s, SW / 2 - _PrintWidth(s) / 2, y, c
End Sub

Sub dimScreen (a As Long)
    Line (0, 0)-(SW - 1, SH - 1), _RGBA32(10, 10, 30, a), BF
End Sub

Function levelLabel$ (n As Long)
    levelLabel$ = "Level" + Str$(n) + " - " + levelName
End Function

Sub drawHud
    Dim bx As Single, bw As Single, p As Single, s As String

    textAt levelLabel(levelNum), 10, 8, _RGB32(255, 255, 255)
    s = "Deaths:" + Str$(levelDeaths)
    textAt s, SW - 10 - _PrintWidth(s), 8, _RGB32(255, 255, 255)

    ' progress bar with the best attempt marked
    bw = 240: bx = SW / 2 - bw / 2
    Line (bx - 2, 10)-Step(bw + 3, 11), _RGBA32(0, 0, 0, 90), BF
    p = progressPct / 100
    Line (bx, 12)-Step(bw * p, 7), _RGB32(255, 255, 255), BF
    If bestPct(levelNum) > 0 Then
        Line (bx + bw * bestPct(levelNum) / 100, 9)-Step(1, 13), _RGB32(255, 210, 60), BF
    End If
    If muted Then textAt "muted", SW - 10 - _PrintWidth("muted"), 26, _RGB32(255, 255, 255)
End Sub

Sub drawTitle
    dimScreen 90
    bigText "LEAP LINE", SW / 2, 110, 6, _RGB32(255, 255, 255)
    centerText "Tap to hop, hold to jump higher. Don't stop, don't fall.", 175, _RGB32(255, 255, 255)
    centerText "<  " + levelLabel(titleLevel) + "  >", 250, _RGB32(255, 230, 120)
    If bestPct(titleLevel) > 0 Then centerText "best:" + Str$(bestPct(titleLevel)) + "%", 272, _RGB32(255, 255, 255)
    If (frameCount \ 30) Mod 2 = 0 Then centerText "SPACE / click / tap to play", 320, _RGB32(255, 255, 255)
    centerText "R restart   M mute   ESC menu", SH - 30, _RGBA32(255, 255, 255, 180)
End Sub

Sub drawDeadScreen
    Dim s As String
    dimScreen 110
    bigText LTrim$(Str$(lastPct)) + "%", SW / 2, 150, 7, _RGB32(255, 255, 255)
    Select Case deathCause
        Case DIE_CRASH: s = "Bonk! Hit a wall."
        Case DIE_SPIKE: s = "Ouch! Spikes."
        Case DIE_LAVA: s = "Too hot!"
        Case DIE_WATER
            If th.hotSea Then s = "Too hot!" Else s = "Splash!"
    End Select
    centerText s, 225, _RGB32(255, 230, 120)
    centerText "best:" + Str$(bestPct(levelNum)) + "%    attempt" + Str$(attempt), 255, _RGB32(255, 255, 255)
    If stateTicks > 15 Then centerText "SPACE / click to retry", 300, _RGB32(255, 255, 255)
End Sub

Sub drawWonScreen
    dimScreen 90
    bigText "COMPLETE!", SW / 2, 140, 5, _RGB32(255, 230, 90)
    centerText "Deaths on this level:" + Str$(levelDeaths), 210, _RGB32(255, 255, 255)
    If stateTicks > 40 Then
        If levelNum < levelCount Then
            centerText "SPACE / click for level" + Str$(levelNum + 1), 260, _RGB32(255, 255, 255)
        Else
            centerText "SPACE / click to finish", 260, _RGB32(255, 255, 255)
        End If
    End If
End Sub

Sub drawEndScreen
    dimScreen 140
    bigText "ALL CLEAR", SW / 2, 140, 6, _RGB32(255, 230, 90)
    centerText "Total deaths:" + Str$(deathsTotal), 220, _RGB32(255, 255, 255)
    If stateTicks > 40 Then centerText "SPACE / click for the title screen", 270, _RGB32(255, 255, 255)
End Sub

'--- sound: soft WAV effects, loaded the same way in QB64-PE and QBJS.
' A missing file just means that effect stays silent.

Sub loadSounds
    Dim names(1 To 10) As String, i As Long
    names(1) = "jump": names(2) = "airjump": names(3) = "flap"
    names(4) = "gem": names(5) = "switch": names(6) = "teleport"
    names(7) = "mode": names(8) = "die": names(9) = "win"
    names(10) = "arrive"
    For i = 1 To 10
        sounds(i) = _SndOpen("sfx/" + names(i) + ".wav")
    Next
End Sub

Sub sfx (n As Long)
    If muted Or headless Then Exit Sub
    If sounds(n) > 0 Then _SndPlayCopy sounds(n)
End Sub
