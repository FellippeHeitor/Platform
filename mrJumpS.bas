'=============================================================================
' GAME FLOW
'=============================================================================

Sub updateGame (held As Long)
    Static prevHeld As Long
    Dim fresh As Long, prevX As Single, prevY As Single
    fresh = held And Not prevHeld
    prevHeld = held
    stateTicks = stateTicks + 1
    frameCount = frameCount + 1

    Select Case gameState
        Case ST_TITLE
            ' attract mode: scroll the camera along the level
            camX = camX + 1.5
            If camX > levelCols * TILE - SW Then camX = 0
            If fresh Then
                levelDeaths = 0
                resetAttempt
                gameState = ST_PLAY
            End If

        Case ST_PLAY
            If teleT > 0 Then
                ' the world waits while the teleport plays out; simTick
                ' doesn't advance, so the level checker's results still hold
                updateTeleport
            Else
                prevX = hero.x: prevY = hero.y
                simTick = simTick + 1
                simEvents = 0
                simStep hero, held
                handleEvents
                If simEvents And EV_TELEPORT Then
                    If freeMove Then startTeleport prevX + hero.xv, prevY Else startTeleport prevX + RUN_SPEED, prevY
                End If
                If popLife > 0 Then popLife = popLife - 1
                If Not hero.alive Then
                    deathsTotal = deathsTotal + 1
                    levelDeaths = levelDeaths + 1
                    lastPct = progressPct
                    If lastPct > bestPct(levelNum) Then bestPct(levelNum) = lastPct
                    recordProgress levelNum
                    deathX = hero.x + HERO_W / 2: deathPending = TRUE
                    deathCause = hero.cause
                    burst hero.x + HERO_W / 2, hero.y + HERO_H / 2, 40, _RGB32(255, 255, 255)
                    burst hero.x + HERO_W / 2, hero.y + HERO_H / 2, 20, _RGB32(230, 70, 70)
                    shake = 10
                    sfx SFX_DIE
                    gameState = ST_DEAD
                    stateTicks = 0
                ElseIf hero.won Then
                    bestPct(levelNum) = 100
                    recordProgress levelNum
                    burst goalX, hero.y, 60, _RGB32(255, 230, 90)
                    If victorySong <= 0 Then sfx SFX_WIN ' the song replaces it
                    gameState = ST_WON
                    stateTicks = 0
                End If
                If teleT = 0 Then followCamera
            End If

        Case ST_DEAD
            ' a short pause so a held button doesn't skip the result
            If fresh And stateTicks > 15 Then resetAttempt: gameState = ST_PLAY

        Case ST_WON
            If fresh And stateTicks > 40 Then
                If levelNum < levelCount Then
                    titleLevel = levelNum + 1
                    loadLevel titleLevel
                    levelDeaths = 0
                    resetAttempt
                    gameState = ST_PLAY
                Else
                    gameState = ST_END
                    stateTicks = 0
                End If
            End If

        Case ST_END
            If fresh And stateTicks > 40 Then
                titleLevel = 1
                loadLevel 1
                gameState = ST_TITLE
            End If
    End Select

    updateParticles
    updateClouds
    shake = shake * .85
    If shake < .3 Then shake = 0
    If squash > .08 Then
        squash = squash - .08
    ElseIf squash < -.08 Then
        squash = squash + .08
    Else
        squash = 0
    End If
End Sub

Sub resetAttempt
    attempt = attempt + 1
    ' the attempt that just ended becomes the dotted line
    If deathPending Then markX = deathX: markPct = lastPct: deathPending = FALSE
    recordProgress levelNum ' playing a level unlocks it on the title screen
    initHero hero
    simTick = 0
    squash = 0
    teleT = 0
    popLife = 0
    camX = cameraTarget
    stateTicks = 0
    gameState = ST_PLAY
End Sub

' Title screen: step to the next level you've already played.
Sub pickLevel (dirn As Long)
    Dim n As Long
    n = titleLevel + dirn
    Do While n >= 1 And n <= levelCount
        If levelUnlocked(n) Then titleLevel = n: loadLevel n: Exit Sub
        n = n + dirn
    Loop
End Sub

Function unlockedCount&
    Dim n As Long, k As Long
    For n = 1 To levelCount
        If levelUnlocked(n) Then k = k + 1
    Next
    unlockedCount& = k
End Function

Function levelUnlocked& (n As Long)
    levelUnlocked& = (n = 1) Or (progIndex(levelNames(n)) > 0)
End Function

Function progIndex& (nm As String)
    Dim i As Long
    For i = 1 To progCount
        If progName(i) = nm Then progIndex& = i: Exit Function
    Next
End Function

' The progress log is a text file next to the game: one "name|best%" line
' per level played. Levels are matched by name, so adding or reordering
' levels keeps what you've earned. (In QBJS the file only lasts the session.)
Sub loadProgress
    Dim i As Long, ff As Long, ln As String, p As Long, n As Long, nm As String
    ReDim levelNames(1 To levelCount) As String
    For n = 1 To levelCount
        levelNames(n) = levelNameOf(n)
    Next
    progCount = 0
    If Not _FileExists(PROGRESS_FILE) Then Exit Sub
    ff = FreeFile
    Open PROGRESS_FILE For Input As #ff
    Do While Not EOF(ff)
        Line Input #ff, ln
        p = InStr(ln, "|")
        If p > 1 And progCount < 99 Then
            progCount = progCount + 1
            progName(progCount) = Left$(ln, p - 1)
            progBest(progCount) = Val(Mid$(ln, p + 1))
        End If
    Loop
    Close #ff
    For n = 1 To levelCount
        i = progIndex(levelNames(n))
        If i > 0 Then bestPct(n) = progBest(i)
    Next
End Sub

Sub recordProgress (n As Long)
    Dim i As Long, ff As Long
    If headless Then Exit Sub
    i = progIndex(levelNames(n))
    If i = 0 Then
        If progCount >= 99 Then Exit Sub
        progCount = progCount + 1: i = progCount
        progName(i) = levelNames(n): progBest(i) = -1
    End If
    If progBest(i) = bestPct(n) Then Exit Sub ' nothing new to save
    progBest(i) = bestPct(n)
    ff = FreeFile
    Open PROGRESS_FILE For Output As #ff
    For i = 1 To progCount
        Print #ff, progName(i) + "|" + LTrim$(Str$(progBest(i)))
    Next
    Close #ff
End Sub

' "-beaten N" on the command line marks levels 1 to N as beaten in the
' progress log and unlocks level N + 1, as if they had been played through.
' Other entries in the log are kept.
Sub seedProgress (cmd As String)
    Dim p As Long, k As Long, n As Long, a As String
    p = InStr(LCase$(cmd), "-beaten")
    If p = 0 Then Exit Sub
    a = LTrim$(Mid$(cmd, p + 7)) ' "-beaten 5", "--beaten=5"
    If Left$(a, 1) = "=" Then a = Mid$(a, 2)
    k = Val(a)
    If k > levelCount Then k = levelCount
    For n = 1 To k
        bestPct(n) = 100
        recordProgress n
    Next
    If k >= 1 And k < levelCount Then recordProgress k + 1
End Sub

Function levelNameOf$ (n As Long)
    Dim i As Long, r As Long, s As String
    Restore
    Read i
    For i = 1 To n - 1
        Read s, r
        For r = 0 To ROWS - 1: Read s: Next
    Next
    Read s
    levelNameOf$ = s
End Function

Function progressPct&
    Dim p As Single
    p = (hero.x - startX) / (goalX - startX) * 100
    If p < 0 Then p = 0
    If p > 100 Then p = 100
    progressPct& = Int(p)
End Function

Sub followCamera
    If freeMove And gameState = ST_PLAY And stateTicks > 0 Then
        camX = camX + (cameraTarget - camX) * .1
    Else
        camX = cameraTarget
    End If
End Sub

Function cameraTarget!
    Dim t As Single
    If freeMove Then
        t = hero.x + HERO_W / 2 - SW / 2 + hero.facing * 90
    Else
        t = hero.x - SW * .28
    End If
    If t > levelCols * TILE - SW Then t = levelCols * TILE - SW
    If t < 0 Then t = 0
    cameraTarget! = t
End Function

Sub handleEvents
    Dim cx As Single, by As Single
    cx = hero.x + HERO_W / 2
    by = hero.y + HERO_H
    If simEvents And EV_JUMP Then squash = -.6: dust cx, by, 5: sfx SFX_JUMP
    If simEvents And EV_AIRJUMP Then squash = -.6: ring cx, by, _RGB32(120, 230, 255): sfx SFX_AIRJUMP
    If simEvents And EV_FLAP Then squash = -.3: sfx SFX_FLAP
    If hero.thrust And (frameCount Mod 2) = 0 Then
        spawnParticle cx - 6, by - 2, -.5 + (Rnd - .5) * .6, 1.5 + Rnd, 12, 2 + Rnd * 2, _RGBA32(255, 190, 90, 200)
    End If
    If simEvents And EV_LAND Then squash = .7: dust cx, by, 6
    If simEvents And EV_GRAB Then squash = .4: sfx SFX_FLAP
    If simEvents And EV_LETGO Then squash = -.5: sfx SFX_JUMP
    If simEvents And EV_GEM Then
        ring cx, hero.y, _RGB32(120, 230, 255): sfx SFX_GEM
        showPopup "+1 AIR JUMP", "press again in mid-air", _RGB32(120, 230, 255)
    End If
    If simEvents And EV_FUEL Then
        ring cx, hero.y, _RGB32(255, 150, 60): sfx SFX_GEM
        If hero.mode = MODE_JET Then
            showPopup "+FUEL", "", _RGB32(255, 160, 80)
        Else
            showPopup "FUEL", "useless without a jetpack", _RGB32(255, 160, 80)
        End If
    End If
    If simEvents And EV_EMPTY Then
        sfx SFX_FLAP: dust cx, hero.y + HERO_H / 2, 8
        showPopup "OUT OF FUEL", "", _RGB32(255, 120, 90)
    End If
    If simEvents And EV_DROP Then
        sfx SFX_FLAP: dust cx, hero.y + HERO_H, 8
        showPopup "JETPACK DROPPED", "it only lasts one flight", _RGB32(255, 160, 80)
    End If
    If simEvents And EV_WINGSOFF Then
        sfx SFX_FLAP: dust cx, hero.y + HERO_H / 2, 8
        showPopup "WINGS GONE", "", _RGB32(200, 230, 210)
    End If
    If simEvents And EV_SWITCH Then
        shake = 4: sfx SFX_SWITCH
        showPopup "SWITCH!", "barriers down", _RGB32(255, 210, 60)
    End If
    If simEvents And EV_MODE Then
        sfx SFX_MODE
        Select Case hero.mode
            Case MODE_JET
                ring cx, hero.y + HERO_H / 2, _RGB32(255, 150, 60)
                showPopup "JETPACK", "hold to fly, tap to nudge - one flight", _RGB32(255, 160, 80)
            Case MODE_WINGS
                ring cx, hero.y + HERO_H / 2, _RGB32(130, 240, 150)
                showPopup "WINGS", "jump as often as you like, briefly", _RGB32(140, 245, 160)
            Case Else
                ring cx, hero.y + HERO_H / 2, _RGB32(170, 210, 255)
                showPopup "ON FOOT", "normal jumps again", _RGB32(180, 215, 255)
        End Select
    End If
End Sub

Sub showPopup (t As String, hint As String, c As _Unsigned Long)
    popText = t: popHint = hint: popColor = c
    popLife = POP_TICKS
End Sub

' The simulation has already moved the hero; this only stages it on screen.
Sub startTeleport (fromX As Single, fromY As Single)
    teleT = TELE_TICKS
    teleFromX = fromX: teleFromY = fromY
    teleCamFrom = camX
    teleCamTo = cameraTarget
    ring fromX + HERO_W / 2, fromY + HERO_H / 2, _RGB32(220, 120, 255)
    sfx SFX_TELEPORT
End Sub

Sub updateTeleport
    Dim p As Single, q As Single
    teleT = teleT - 1
    p = teleProgress
    ' camera glides between the beam-out and beam-in, easing in and out
    q = (p - .3) / .45
    If q < 0 Then q = 0
    If q > 1 Then q = 1
    camX = teleCamFrom + (teleCamTo - teleCamFrom) * q * q * (3 - 2 * q)
    If p < .3 Then sparkle teleFromX + HERO_W / 2, teleFromY + HERO_H / 2
    If p > .75 Then sparkle hero.x + HERO_W / 2, hero.y + HERO_H / 2
    If teleT = Int(TELE_TICKS * .25) Then
        ring hero.x + HERO_W / 2, hero.y + HERO_H / 2, _RGB32(220, 120, 255)
        sfx SFX_ARRIVE
    End If
    If teleT = 0 Then followCamera
End Sub

Function teleProgress!
    teleProgress! = 1 - teleT / TELE_TICKS
End Function

'=============================================================================
' SIMULATION
' Everything that decides life or death lives in initHero/simStep and reads
' only `tiles()` and the HeroState passed in, so the solver can run it too.
'=============================================================================

Sub initHero (h As HeroState)
    h.x = startX
    h.y = startY
    h.yv = 0
    h.airJumps = 0
    h.mode = MODE_RUN
    h.grounded = TRUE
    h.coyote = 0
    h.buffer = 0
    h.heldPrev = TRUE ' the press that started this attempt must not also jump
    h.jumping = FALSE
    h.openMask = 0
    h.gemMask = 0
    h.alive = TRUE
    h.won = FALSE
    h.cause = DIE_NONE
    h.fuel = 0
    h.wingTicks = 0
    h.thrust = FALSE
    h.xv = 0
    h.facing = 1
    h.vine = 0
    h.vineCool = 0
    h.vineT = 0
    h.relVine = 0
    h.relOff = 0
    h.relSpd = 0
    h.clock = 0
    h.back = 0
End Sub

' One tick of the hero, plus the world clock. The world (crocs, toggles,
' vines other than the one held) only moves on as the hero gains new ground:
' running, one tick of world time per tick. Hanging on a vine for as long as
' you like, or swinging back and forth, doesn't use any of it up, so once
' you're past the furthest point you'd reached, everything is where it would
' be had you run straight there, and what's ahead is down to timed jumps.
' Without vines this is exactly one world tick per tick (= simTick).
Sub simStep (h As HeroState, held As Long)
    Dim x0 As Single, wasVine As Long, c0 As Single
    x0 = h.x: wasVine = h.vine: c0 = h.clock
    worldTick = Int(h.clock + .001) + 1
    simMove h, held
    If freeMove Or (wasVine = 0 And h.vine = 0 And h.back <= 0) Then
        h.clock = h.clock + 1
    Else
        h.back = h.back - (h.x - x0) / RUN_SPEED
        If h.back < 0 Then h.clock = h.clock - h.back: h.back = 0
    End If
    If h.relVine > 0 Then easeVine h, h.clock - c0
End Sub

' A vine you let go of was swinging at its own pace, out of step with the
' world. Snapping it back would jerk it away, so it keeps swinging and its
' speed eases off or picks up until it's back in step (a few seconds at most),
' then it follows the world clock like the rest. dw is how far the world
' clock moved this tick.
Sub easeVine (h As HeroState, dw As Single)
    Dim pull As Single
    pull = -h.relOff * .03
    If pull > .6 Then pull = .6
    If pull < -.6 Then pull = -.6
    h.relSpd = h.relSpd + (dw + pull - h.relSpd) * VINE_EASE
    h.relOff = h.relOff + h.relSpd - dw
    If Abs(h.relOff) < .5 And Abs(h.relSpd - dw) < .05 Then h.relVine = 0: h.relOff = 0
End Sub

Sub simMove (h As HeroState, held As Long)
    Dim pressed As Long, wasGrounded As Long, prevBottom As Single
    Dim i As Long, landY As Single, ceilY As Single

    pressed = held And Not h.heldPrev
    h.heldPrev = held
    If pressed Then h.buffer = BUFFER_TICKS
    If h.vineCool > 0 Then h.vineCool = h.vineCool - 1

    ' --- hanging on a vine: carried by it until the button is pressed
    If h.vine > 0 Then
        If pressed Then
            letGoVine h
            pressed = FALSE ' this press was for letting go, not a jump
        Else
            h.vineT = h.vineT + 1
            hangOnVine h
            touchTiles h
            If h.x >= goalX Then h.won = TRUE
            Exit Sub
        End If
    End If

    ' --- wings wear off
    If h.mode = MODE_WINGS Then
        h.wingTicks = h.wingTicks - 1
        If h.wingTicks <= 0 Then h.mode = MODE_RUN: h.jumping = FALSE: simEvents = simEvents Or EV_WINGSOFF
    End If

    ' --- jump input
    h.thrust = FALSE
    If h.mode = MODE_JET Then
        ' hold to thrust upwards; fuel burns only while held, so a quick tap
        ' is a small nudge that costs little
        h.buffer = 0
        If held And h.fuel > 0 Then
            h.thrust = TRUE
            h.yv = h.yv - JET_THRUST
            If h.yv < -JET_MAX_UP Then h.yv = -JET_MAX_UP
            h.fuel = h.fuel - 1
            If pressed Then simEvents = simEvents Or EV_FLAP
            If h.fuel <= 0 Then h.mode = MODE_RUN: h.jumping = FALSE: simEvents = simEvents Or EV_EMPTY
        End If
    Else
        If h.buffer > 0 And (h.grounded Or h.coyote > 0) Then
            h.yv = -JUMP_V
            h.buffer = 0
            h.coyote = 0
            h.grounded = FALSE
            h.jumping = TRUE
            simEvents = simEvents Or EV_JUMP
        ElseIf pressed And Not h.grounded And (h.airJumps > 0 Or h.mode = MODE_WINGS) Then
            If h.mode <> MODE_WINGS Then h.airJumps = h.airJumps - 1
            h.yv = -AIR_JUMP_V
            h.buffer = 0
            h.jumping = TRUE
            simEvents = simEvents Or EV_AIRJUMP
        End If
        ' releasing early cuts the jump short: the tap length sets the height
        If Not held And h.jumping And h.yv < -CUT_V Then h.yv = -CUT_V
    End If
    If h.buffer > 0 Then h.buffer = h.buffer - 1

    ' --- gravity
    If h.mode = MODE_JET Then
        h.yv = h.yv + JET_GRAVITY
        If h.yv > JET_MAX_FALL Then h.yv = JET_MAX_FALL
    Else
        h.yv = h.yv + GRAVITY
        If h.yv > MAX_FALL Then h.yv = MAX_FALL
    End If

    ' --- horizontal: always running. Hitting a wall is fatal, but small
    ' ledges (STEP_TOL pixels) are climbed automatically.
    If freeMove Then
        freeMoveStep h
        If Not h.alive Then Exit Sub
    Else
        h.x = h.x + RUN_SPEED
    End If
    If Not freeMove And overlapsSolid(h, h.x, h.y) Then
        For i = 1 To STEP_TOL
            If Not overlapsSolid(h, h.x, h.y - i) Then Exit For
        Next
        If i > STEP_TOL Then
            h.alive = FALSE: h.cause = DIE_CRASH
            If touchingLava(h, h.x, h.y) Then h.cause = DIE_LAVA
            Exit Sub
        End If
        h.y = h.y - i
    End If

    ' --- vertical
    wasGrounded = h.grounded
    prevBottom = h.y + HERO_H
    h.y = h.y + h.yv
    h.grounded = FALSE
    If h.yv >= 0 Then
        landY = findFloor(h, prevBottom, h.y + HERO_H)
        If landY >= 0 Then
            h.y = landY - HERO_H
            h.yv = 0
            h.grounded = TRUE
            If Not wasGrounded Then
                simEvents = simEvents Or EV_LAND
                ' the jetpack is for one flight: touching down drops it
                If h.mode = MODE_JET Then h.mode = MODE_RUN: h.fuel = 0: simEvents = simEvents Or EV_DROP
            End If
            h.jumping = FALSE
            If touchingLava(h, h.x, h.y + 1) Then h.alive = FALSE: h.cause = DIE_LAVA: Exit Sub
        End If
    Else
        ceilY = findCeiling(h)
        If ceilY >= 0 Then h.y = ceilY: h.yv = 0
    End If

    If h.grounded Then
        h.coyote = 0
    ElseIf wasGrounded And Not h.jumping Then
        h.coyote = COYOTE_TICKS ' just walked off a ledge
    ElseIf h.coyote > 0 Then
        h.coyote = h.coyote - 1
    End If

    If h.mode = MODE_JET And h.y < 0 Then h.y = 0: h.yv = 0

    If Not h.grounded Then catchVine h

    touchTiles h
    If Not h.alive Then Exit Sub

    If h.y > WATER_Y - HERO_H / 2 Then h.alive = FALSE: h.cause = DIE_WATER: Exit Sub
    If h.x >= goalX Then h.won = TRUE
End Sub

' Walking under player control: ease towards the wanted speed, climb small
' ledges, stop at walls (lava walls still burn).
Sub freeMoveStep (h As HeroState)
    Dim target As Single, nx As Single, i As Long, dirn As Long
    target = moveDir * RUN_SPEED
    If moveDir <> 0 Then h.facing = moveDir
    If h.grounded Then
        h.xv = h.xv + (target - h.xv) * .35
    Else
        h.xv = h.xv + (target - h.xv) * .15
    End If
    If Abs(h.xv) < .05 Then h.xv = 0: Exit Sub
    nx = h.x + h.xv
    If nx < 0 Then nx = 0: h.xv = 0
    If nx > levelCols * TILE - HERO_W Then nx = levelCols * TILE - HERO_W: h.xv = 0
    If Not overlapsSolid(h, nx, h.y) Then h.x = nx: Exit Sub
    For i = 1 To STEP_TOL
        If Not overlapsSolid(h, nx, h.y - i) Then h.x = nx: h.y = h.y - i: Exit Sub
    Next
    ' blocked: slide up to the wall
    If h.xv > 0 Then dirn = 1 Else dirn = -1
    If touchingLava(h, h.x + dirn, h.y) Then h.alive = FALSE: h.cause = DIE_LAVA: Exit Sub
    Do While Abs(nx - h.x) > .01
        If overlapsSolid(h, h.x + dirn * .5, h.y) Then Exit Do
        h.x = h.x + dirn * .5
        If dirn * (h.x - nx) > 0 Then h.x = nx
    Loop
    h.xv = 0
End Sub

' Vines all swing together, so where a vine's tip is depends only on the
' tick: angle = VINE_AMP * sin(2 pi tick / VINE_PERIOD). That's the world
' tick, except for the vine being held, which goes on from where it was
' caught at its own pace (hero.vineT).
Function vineAngle! (tick As Single)
    vineAngle! = VINE_AMP * Sin(6.2831853 * tick / VINE_PERIOD)
End Function

' (Two functions rather than a Sub with output parameters: QBJS passes
' numbers to subs by value.)
Function vineTipX! (v As Long, tick As Single)
    vineTipX! = vineAX(v) + VINE_LEN * Sin(vineAngle(tick))
End Function

Function vineTipY! (v As Long, tick As Single)
    vineTipY! = vineAY(v) + VINE_LEN * Cos(vineAngle(tick))
End Function

' The hero hangs from the tip by the hands.
Sub hangOnVine (h As HeroState)
    h.x = vineTipX(h.vine, h.vineT) - HERO_W / 2: h.y = vineTipY(h.vine, h.vineT) - 2
    h.grounded = FALSE: h.coyote = 0: h.jumping = FALSE: h.buffer = 0
    h.xv = 0
End Sub

' Where vine v is in its swing: the world tick tick0 (worldTick in the
' simulation, one less when drawing), except for a vine that's still easing
' back into step after being let go (see easeVine).
Function vinePhase! (h As HeroState, v As Long, tick0 As Long)
    If v = h.relVine Then
        vinePhase! = h.clock + h.relOff + (tick0 - Int(h.clock + .001))
    Else
        vinePhase! = tick0
    End If
End Function

' Let go: keep the vine's speed, plus a little hop. The vine swings on from
' where it is and eases back into step with the others.
Sub letGoVine (h As HeroState)
    Dim o As Single
    h.yv = vineTipY(h.vine, h.vineT) - vineTipY(h.vine, h.vineT - 1) - 5
    h.xv = vineTipX(h.vine, h.vineT) - vineTipX(h.vine, h.vineT - 1)
    ' how far ahead of the world clock it is, the short way round the swing
    o = h.vineT - (h.clock + 1)
    o = o - VINE_PERIOD * Int(o / VINE_PERIOD + .5)
    h.relVine = h.vine: h.relOff = o: h.relSpd = 1
    h.vine = 0
    h.vineCool = VINE_COOL
    h.buffer = 0
    simEvents = simEvents Or EV_LETGO
End Sub

' Catch a vine whose tip is at the hero's hands.
Sub catchVine (h As HeroState)
    Dim v As Long, tx As Single, ty As Single, k As Single
    If h.vineCool > 0 Or nVines = 0 Then Exit Sub
    For v = 1 To nVines
        ' a vine you let go of is out of reach until it's back in step: it
        ' swings along with you, and catching it again mid-air isn't the idea
        k = vinePhase(h, v, worldTick)
        tx = vineTipX(v, k): ty = vineTipY(v, k)
        If v <> h.relVine And Abs(h.x + HERO_W / 2 - tx) < 16 Then
            If h.y > ty - 18 And h.y < ty + 16 Then
                h.vine = v
                h.vineT = k
                hangOnVine h
                simEvents = simEvents Or EV_GRAB
                Exit Sub
            End If
        End If
    Next
End Sub

' Crocodile jaws: shut (safe to stand on) for most of the cycle, then open.
Function crocOpen& (tick As Long)
    crocOpen& = (tick Mod CROC_PERIOD) >= CROC_OPEN_AT
End Function

Function tileAt& (c As Long, r As Long)
    If c < 0 Or c >= levelCols Or r < 0 Or r >= ROWS Then
        tileAt& = T_EMPTY
    Else
        tileAt& = tiles(c, r)
    End If
End Function

Function isSolid& (h As HeroState, c As Long, r As Long)
    Dim t As Long
    t = tileAt(c, r)
    isSolid& = (t = T_GROUND) Or (t = T_LAVA) Or (t = T_CROC)
    If t = T_BARRIER Then isSolid& = ((h.openMask And 2 ^ gemIndex(c, r)) = 0) ' tileAt said c, r is on the map
End Function

Function overlapsSolid& (h As HeroState, x As Single, y As Single)
    Dim c As Long, r As Long
    overlapsSolid& = FALSE
    For c = Int((x - clearance) / TILE) To Int((x + HERO_W + clearance - .01) / TILE)
        For r = Int((y - clearance) / TILE) To Int((y + HERO_H - .01) / TILE)
            If isSolid(h, c, r) Then overlapsSolid& = TRUE: Exit Function
        Next
    Next
End Function

Function touchingLava& (h As HeroState, x As Single, y As Single)
    Dim c As Long, r As Long
    touchingLava& = FALSE
    For c = Int(x / TILE) To Int((x + HERO_W - .01) / TILE)
        For r = Int(y / TILE) To Int((y + HERO_H - .01) / TILE)
            If tileAt(c, r) = T_LAVA Then touchingLava& = TRUE: Exit Function
        Next
    Next
End Function

' Top y of the first floor crossed while moving from prevBottom to newBottom,
' or -1. Planks only catch you from above.
Function findFloor! (h As HeroState, prevBottom As Single, newBottom As Single)
    Dim c As Long, r As Long, t As Long, top As Single
    findFloor! = -1
    For r = Int(prevBottom / TILE) To Int((newBottom - .01) / TILE)
        top = r * TILE
        If top >= prevBottom - .5 And top <= newBottom Then
            For c = Int(h.x / TILE) To Int((h.x + HERO_W - .01) / TILE)
                t = tileAt(c, r)
                If isSolid(h, c, r) Or t = T_PLANK Then findFloor! = top: Exit Function
            Next
        End If
    Next
End Function

' Bottom y of a solid tile the head is inside after moving up, or -1.
Function findCeiling! (h As HeroState)
    Dim c As Long, r As Long
    findCeiling! = -1
    r = Int((h.y - clearance) / TILE)
    For c = Int(h.x / TILE) To Int((h.x + HERO_W - .01) / TILE)
        If isSolid(h, c, r) Then findCeiling! = (r + 1) * TILE + clearance: Exit Function
    Next
End Function

Function toggleUp& (t As Long)
    Dim phase As Long
    phase = (worldTick \ TOGGLE_TICKS) Mod 2
    toggleUp& = (t = T_TOGGLEA And phase = 0) Or (t = T_TOGGLEB And phase = 1)
End Function

' Hazards and pickups the hero's box is touching.
Sub touchTiles (h As HeroState)
    Dim c As Long, r As Long, t As Long, bit As Long, m As Long
    Dim hx1 As Single, hy1 As Single, hx2 As Single, hy2 As Single
    Dim tx As Single, ty As Single

    ' hazards: a slightly smaller box, so near misses feel fair (grown by
    ' `clearance` when the level checker measures how much room there is)
    hx1 = h.x + 2 - clearance: hx2 = h.x + HERO_W - 2 + clearance
    hy1 = h.y + 2 - clearance: hy2 = h.y + HERO_H - 1 + clearance
    For c = Int(hx1 / TILE) To Int((hx2 - .01) / TILE)
        For r = Int(hy1 / TILE) To Int((hy2 + 10) / TILE) ' + 10: open jaws reach above the head
            t = tileAt(c, r)
            tx = c * TILE: ty = r * TILE
            Select Case t
                Case T_CROC
                    ' only the snout (the croc's left tile) bites; the head
                    ' behind it is a safe spot, as in Pitfall
                    If crocOpen(worldTick) And tileAt(c - 1, r) <> T_CROC Then
                        If boxHit(hx1, hy1, hx2, hy2, tx, ty - 10, tx + TILE - 3, ty + TILE) Then
                            h.alive = FALSE: h.cause = DIE_CROC: Exit Sub
                        End If
                    End If
                Case T_SPIKE, T_TOGGLEA, T_TOGGLEB
                    If t = T_SPIKE Or toggleUp(t) Then
                        If boxHit(hx1, hy1, hx2, hy2, tx + 6, ty + 11, tx + TILE - 6, ty + TILE) Then
                            h.alive = FALSE: h.cause = DIE_SPIKE: Exit Sub
                        End If
                    End If
                Case T_SPIKEDOWN
                    If boxHit(hx1, hy1, hx2, hy2, tx + 6, ty, tx + TILE - 6, ty + TILE - 11) Then
                        h.alive = FALSE: h.cause = DIE_SPIKE: Exit Sub
                    End If
                Case T_LAVA
                    If boxHit(hx1, hy1, hx2, hy2, tx, ty, tx + TILE, ty + TILE) Then
                        h.alive = FALSE: h.cause = DIE_LAVA: Exit Sub
                    End If
            End Select
        Next
    Next

    ' pickups and triggers: the hero's real box
    For c = Int(h.x / TILE) To Int((h.x + HERO_W - .01) / TILE)
        For r = Int(h.y / TILE) To Int((h.y + HERO_H - .01) / TILE)
            t = tileAt(c, r)
            Select Case t
                Case T_GEM, T_FUEL
                    bit = 2 ^ gemIndex(c, r)
                    If (h.gemMask And bit) = 0 Then
                        h.gemMask = h.gemMask Or bit
                        If t = T_GEM Then
                            h.airJumps = h.airJumps + 1
                            simEvents = simEvents Or EV_GEM
                        Else
                            ' a can refills a running jetpack; without one it's wasted
                            If h.mode = MODE_JET Then h.fuel = h.fuel + fuelCanAmt
                            simEvents = simEvents Or EV_FUEL
                        End If
                    End If
                Case T_SWITCH
                    bit = 2 ^ gemIndex(c, r)
                    If (h.openMask And bit) = 0 Then h.openMask = h.openMask Or bit: simEvents = simEvents Or EV_SWITCH
                Case T_TELEIN, T_TELEOUT
                    ' auto-run: touching an entrance teleports. Free move:
                    ' they're doors, up enters, and exits lead back
                    If freeMove Then
                        m = doorPress
                    Else
                        m = (t = T_TELEIN)
                    End If
                    If m And teleCol(c, r) >= 0 Then
                        doorPress = FALSE
                        h.x = teleCol(c, r) * TILE + (TILE - HERO_W) / 2
                        h.y = teleRow(c, r) * TILE + TILE - HERO_H
                        simEvents = simEvents Or EV_TELEPORT
                        Exit Sub
                    End If
                Case T_JET, T_WINGS, T_NORMAL
                    ' one-time pickups, like diamonds: gone once collected
                    bit = 2 ^ gemIndex(c, r)
                    If (h.gemMask And bit) = 0 Then
                        h.gemMask = h.gemMask Or bit
                        m = MODE_RUN
                        If t = T_JET Then m = MODE_JET
                        If t = T_WINGS Then m = MODE_WINGS
                        If m = MODE_JET And h.fuel < jetFuelFull Then h.fuel = jetFuelFull
                        If m = MODE_WINGS Then h.wingTicks = wingFull
                        h.mode = m
                        h.jumping = FALSE
                        simEvents = simEvents Or EV_MODE
                    End If
            End Select
        Next
    Next
End Sub

Function boxHit& (ax1 As Single, ay1 As Single, ax2 As Single, ay2 As Single, bx1 As Single, by1 As Single, bx2 As Single, by2 As Single)
    boxHit& = ax1 < bx2 And ax2 > bx1 And ay1 < by2 And ay2 > by1
End Function

'=============================================================================
' LEVEL LOADING
'=============================================================================

Sub countLevels
    Restore
    Read levelCount
End Sub

Sub loadLevel (n As Long)
    Dim i As Long, r As Long, c As Long, s As String, ch As String
    Dim rowsText(0 To ROWS - 1) As String, gems As Long

    Restore
    Read levelCount
    ' skip earlier levels: each is name, theme, then ROWS rows
    For i = 1 To n - 1
        Read s, r
        For r = 0 To ROWS - 1: Read s: Next
    Next
    Read levelName, levelTheme
    levelCols = 0
    For r = 0 To ROWS - 1
        Read rowsText(r)
        If Len(rowsText(r)) > levelCols Then levelCols = Len(rowsText(r))
    Next

    levelNum = n
    ReDim tiles(0 To levelCols - 1, 0 To ROWS - 1) As Long
    ReDim gemIndex(0 To levelCols - 1, 0 To ROWS - 1) As Long
    ReDim teleCol(0 To levelCols - 1, 0 To ROWS - 1) As Long
    ReDim teleRow(0 To levelCols - 1, 0 To ROWS - 1) As Long
    goalX = (levelCols - 10) * TILE
    startX = 2 * TILE: startY = 15 * TILE + TILE - HERO_H
    gems = 0
    nVines = 0
    markX = -1: deathPending = FALSE

    For r = 0 To ROWS - 1
        For c = 0 To levelCols - 1
            ch = Mid$(rowsText(r), c + 1, 1)
            Select Case ch
                Case "#": tiles(c, r) = T_GROUND
                Case "=": tiles(c, r) = T_PLANK
                Case "^": tiles(c, r) = T_SPIKE
                Case "v": tiles(c, r) = T_SPIKEDOWN
                Case "L": tiles(c, r) = T_LAVA
                Case "*", "F"
                    If ch = "*" Then tiles(c, r) = T_GEM Else tiles(c, r) = T_FUEL
                    gemIndex(c, r) = gems Mod MAX_GEMS
                    gems = gems + 1
                Case "T": tiles(c, r) = T_TOGGLEA
                Case "t": tiles(c, r) = T_TOGGLEB
                Case "C": tiles(c, r) = T_CROC
                Case "V"
                    tiles(c, r) = T_VINE
                    If nVines < MAX_VINES Then
                        nVines = nVines + 1
                        vineAX(nVines) = c * TILE + TILE / 2: vineAY(nVines) = r * TILE
                    End If
                Case "S": tiles(c, r) = T_SWITCH
                Case "B": tiles(c, r) = T_BARRIER
                Case "O": tiles(c, r) = T_TELEIN
                Case "o": tiles(c, r) = T_TELEOUT
                Case "J", "W", "N"
                    If ch = "J" Then tiles(c, r) = T_JET
                    If ch = "W" Then tiles(c, r) = T_WINGS
                    If ch = "N" Then tiles(c, r) = T_NORMAL
                    gemIndex(c, r) = gems Mod MAX_GEMS
                    gems = gems + 1
                Case "G": tiles(c, r) = T_GOAL: goalX = c * TILE: goalRow = r
                Case "@": startX = c * TILE + (TILE - HERO_W) / 2: startY = r * TILE + TILE - HERO_H
                Case Else: tiles(c, r) = T_EMPTY
            End Select
        Next
    Next
    pairTeleporters
    groupSwitches

    initHero hero
    If Not headless Then
        th = themes(levelTheme)
        bakeBackground
        bakeLevel
        initClouds
    End If
    camX = 0
    attempt = 0
End Sub

' Each switch opens the barriers after it, up to the next switch: number the
' switches left to right and give each barrier the number of the switch
' before it (kept in gemIndex, which switches and barriers don't otherwise use).
Sub groupSwitches
    Dim c As Long, r As Long, n As Long
    n = -1
    For c = 0 To levelCols - 1
        For r = 0 To ROWS - 1
            If tiles(c, r) = T_SWITCH Then n = n + 1: gemIndex(c, r) = n Mod MAX_GEMS
        Next
        For r = 0 To ROWS - 1
            If tiles(c, r) = T_BARRIER Then
                If n < 0 Then gemIndex(c, r) = MAX_GEMS Else gemIndex(c, r) = n Mod MAX_GEMS
            End If
        Next
    Next
End Sub

' Each teleporter leads to the nearest exit to its right. Exits link back to
' their teleporter, for free-move mode where portals work both ways.
Sub pairTeleporters
    Dim c As Long, r As Long, c2 As Long, r2 As Long, found As Long
    For c = 0 To levelCols - 1
        For r = 0 To ROWS - 1
            teleCol(c, r) = -1
            If tiles(c, r) = T_TELEIN Then
                found = FALSE
                For c2 = c + 1 To levelCols - 1
                    For r2 = 0 To ROWS - 1
                        If tiles(c2, r2) = T_TELEOUT Then teleCol(c, r) = c2: teleRow(c, r) = r2: found = TRUE: Exit For
                    Next
                    If found Then Exit For
                Next
            End If
        Next
    Next
    For c = 0 To levelCols - 1
        For r = 0 To ROWS - 1
            If tiles(c, r) = T_TELEIN Then
                If teleCol(c, r) >= 0 Then
                    c2 = teleCol(c, r): r2 = teleRow(c, r)
                    teleCol(c2, r2) = c: teleRow(c2, r2) = r
                End If
            End If
        Next
    Next
End Sub

