' One-button auto-runner engine.
' Runs in QB64-PE and in QBJS (no QBJS-specific code needed).
'
' Hold to jump higher, tap for a short hop. Levels are hand-made and fixed,
' so every attempt is the same course: learn it, die, retry.
'
' Controls: SPACE / mouse button / touch = jump, R = restart attempt,
'           M = mute, ESC = back to title (ESC on title quits)
'
' Level check (native only): compile levelcheck.bas, which includes this
' file with HEADLESS set plus tools/solver.bm, and proves every level can be
' beaten by searching all button timings through the same physics code.

Option _Explicit

Const TRUE = -1
Const FALSE = 0

Const SW = 800
Const SH = 450
Const TILE = 25
Const ROWS = 18
Const WATER_Y = 438

' tile codes
Const T_EMPTY = 0
Const T_GROUND = 1
Const T_PLANK = 2
Const T_SPIKE = 3
Const T_SPIKEDOWN = 4
Const T_LAVA = 5
Const T_GEM = 6
Const T_TOGGLEA = 7
Const T_TOGGLEB = 8
Const T_SWITCH = 9
Const T_BARRIER = 10
Const T_TELEIN = 11
Const T_TELEOUT = 12
Const T_JET = 13
Const T_WINGS = 14
Const T_NORMAL = 15
Const T_GOAL = 16
Const T_FUEL = 17

' hero modes
Const MODE_RUN = 0
Const MODE_JET = 1
Const MODE_WINGS = 2

' physics, per 1/60 s tick
Const STEP_DT = 1 / 60
Const RUN_SPEED = 4
Const GRAVITY = 0.6
Const JUMP_V = 10.2
Const CUT_V = 4
Const AIR_JUMP_V = 9
Const MAX_FALL = 12
Const JET_THRUST = 0.8 ' upward push per tick while the button is held
Const JET_MAX_UP = 5.5
Const JET_MAX_FALL = 7
Const JET_GRAVITY = 0.35
Const COYOTE_TICKS = 5
Const BUFFER_TICKS = 7
Const STEP_TOL = 7
Const HERO_W = 14
Const HERO_H = 20
Const TOGGLE_TICKS = 50
Const MAX_GEMS = 30 ' diamonds and fuel cans per level
Const JET_FUEL = 150 ' ticks of thrust in a fresh jetpack (2.5 s held)
Const FUEL_CAN = 75 ' ticks of thrust added by a fuel can
Const WING_TICKS = 150 ' how long wings last (2.5 s)

' death causes
Const DIE_NONE = 0
Const DIE_CRASH = 1
Const DIE_SPIKE = 2
Const DIE_LAVA = 3
Const DIE_WATER = 4

' simulation events, for effects and sound (bit flags)
Const EV_JUMP = 1
Const EV_AIRJUMP = 2
Const EV_LAND = 4
Const EV_GEM = 8
Const EV_SWITCH = 16
Const EV_TELEPORT = 32
Const EV_MODE = 64
Const EV_FLAP = 128
Const EV_FUEL = 256
Const EV_EMPTY = 512 ' jetpack out of fuel
Const EV_WINGSOFF = 1024 ' wings worn off
Const EV_DROP = 2048 ' landed with a jetpack, which drops it

' sound effects (files in sfx/, made by tools/make_sfx.bas)
Const SFX_JUMP = 1
Const SFX_AIRJUMP = 2
Const SFX_FLAP = 3
Const SFX_GEM = 4
Const SFX_SWITCH = 5
Const SFX_TELEPORT = 6
