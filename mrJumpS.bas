'--- particles

Sub spawnParticle (x As Single, y As Single, xv As Single, yv As Single, life As Single, size As Single, c As _Unsigned Long)
    Dim i As Long
    For i = 1 To UBound(particles)
        If particles(i).life <= 0 Then
            particles(i).x = x: particles(i).y = y
            particles(i).xv = xv: particles(i).yv = yv
            particles(i).life = life: particles(i).maxLife = life
            particles(i).size = size: particles(i).c = c
            Exit Sub
        End If
    Next
End Sub

Sub burst (x As Single, y As Single, n As Long, c As _Unsigned Long)
    Dim i As Long, a As Single, s As Single
    For i = 1 To n
        a = Rnd * 6.283: s = 1 + Rnd * 5
        spawnParticle x, y, Cos(a) * s, Sin(a) * s - 2, 30 + Rnd * 30, 2 + Rnd * 3, c
    Next
End Sub

Sub dust (x As Single, y As Single, n As Long)
    Dim i As Long
    For i = 1 To n
        spawnParticle x + (Rnd - .5) * 10, y - 2, (Rnd - .7) * 2, -Rnd * 1.2, 15 + Rnd * 10, 2 + Rnd * 2, _RGBA32(255, 255, 255, 180)
    Next
End Sub

Sub ring (x As Single, y As Single, c As _Unsigned Long)
    Dim i As Long, a As Single
    For i = 0 To 11
        a = i * 6.283 / 12
        spawnParticle x, y, Cos(a) * 3, Sin(a) * 3, 20, 3, c
    Next
End Sub

Sub updateParticles
    Dim i As Long
    For i = 1 To UBound(particles)
        If particles(i).life > 0 Then
            particles(i).x = particles(i).x + particles(i).xv
            particles(i).y = particles(i).y + particles(i).yv
            particles(i).yv = particles(i).yv + .15
            particles(i).xv = particles(i).xv * .97
            particles(i).life = particles(i).life - 1
        End If
    Next
End Sub

Sub drawParticles (cx As Long, oy As Long)
    Dim i As Long, s As Single, a As Single, c As _Unsigned Long
    For i = 1 To UBound(particles)
        If particles(i).life > 0 Then
            a = particles(i).life / particles(i).maxLife
            c = particles(i).c
            s = particles(i).size
            Line (particles(i).x - cx - s / 2, particles(i).y + oy - s / 2)-Step(s, s), _RGBA32(_Red32(c), _Green32(c), _Blue32(c), alpha32(c) * a), BF
        End If
    Next
End Sub

'--- text and screens

' Scaled text: print into a small image, then stretch it onto the screen.
' Large text: each string is printed once, every pixel snapped fully on or
' off (browser fonts have soft edges that turn into grey blocks when scaled
' up), then cached and scaled. Fading text reuses a few alpha steps.
Sub bigText (s As String, cx As Single, cy As Single, scale As Single, c As _Unsigned Long)
    Dim x As Single, y As Single, w As Long, h As Long, a As Long, img As Long
    If Len(s) = 0 Then Exit Sub
    w = _PrintWidth(s): h = _FontHeight
    x = cx - w * scale / 2: y = cy - h * scale / 2
    a = alpha32(c)
    If a >= 224 Then a = 255 Else a = (a \ 32) * 32
    If a = 0 Then Exit Sub
    img = crispText(s, _RGBA32(30, 26, 46, a))
    _PutImage (x + scale, y + scale)-(x + scale + w * scale - 1, y + scale + h * scale - 1), img
    img = crispText(s, _RGBA32(_Red32(c), _Green32(c), _Blue32(c), a))
    _PutImage (x, y)-(x + w * scale - 1, y + h * scale - 1), img
End Sub

Function crispText& (s As String, c As _Unsigned Long)
    Dim i As Long, k As String, tmp As Long, img As Long, w As Long, h As Long, x As Long, y As Long
    k = s + "|" + Hex$(c)
    For i = 1 To TEXT_CACHE
        If textKey(i) = k Then crispText& = textImg(i): Exit Function
    Next
    w = _PrintWidth(s): h = _FontHeight
    tmp = _NewImage(w, h, 32)
    _Dest tmp
    _PrintMode _KeepBackground
    Color _RGB32(255, 255, 255)
    _PrintString (0, 0), s
    img = _NewImage(w, h, 32)
    _Dest img
    _Source tmp
    For y = 0 To h - 1
        For x = 0 To w - 1
            If alpha32(Point(x, y)) >= 128 Then PSet (x, y), c
        Next
    Next
    _Source 0
    _Dest 0
    _FreeImage tmp
    textNext = textNext Mod TEXT_CACHE + 1
    If textImg(textNext) <> 0 Then _FreeImage textImg(textNext)
    textImg(textNext) = img: textKey(textNext) = k
    crispText& = img
End Function

' Alpha (0-255) of a 32-bit colour. qbjs.org's _Alpha32 returns 0-1 (fixed
' in newer QBJS), so read the top byte directly.
Function alpha32& (c As _Unsigned Long)
    alpha32& = (c \ 16777216) And 255
End Function

Sub putText (s As String, x As Single, y As Single, scale As Single, c As _Unsigned Long)
    Dim img As Long, w As Long, h As Long
    w = _PrintWidth(s): h = _FontHeight
    img = _NewImage(w, h, 32)
    _Dest img
    _PrintMode _KeepBackground
    Color c
    _PrintString (0, 0), s
    _Dest 0
    _PutImage (x, y)-(x + w * scale - 1, y + h * scale - 1), img
    _FreeImage img
End Sub

Sub textAt (s As String, x As Single, y As Single, c As _Unsigned Long)
    _PrintMode _KeepBackground
    Color _RGBA32(0, 0, 0, 120)
    _PrintString (x + 1, y + 1), s
    Color c
    _PrintString (x, y), s
End Sub

Sub centerText (s As String, y As Single, c As _Unsigned Long)
    textAt s, SW / 2 - _PrintWidth(s) / 2, y, c
End Sub

Sub dimScreen (a As Long)
    Line (0, 0)-(SW - 1, SH - 1), _RGBA32(10, 10, 30, a), BF
End Sub

Function levelLabel$ (n As Long)
    levelLabel$ = "Level" + Str$(n) + " - " + levelName
End Function

Sub drawHud
    Dim bx As Single, bw As Single, p As Single, s As String

    textAt levelLabel(levelNum), 10, 8, _RGB32(255, 255, 255)
    s = "Deaths:" + Str$(levelDeaths)
    textAt s, SW - 10 - _PrintWidth(s), 8, _RGB32(255, 255, 255)

    ' progress bar with the best attempt marked
    bw = 240: bx = SW / 2 - bw / 2
    Line (bx - 2, 10)-Step(bw + 3, 11), _RGBA32(0, 0, 0, 90), BF
    p = progressPct / 100
    Line (bx, 12)-Step(bw * p, 7), _RGB32(255, 255, 255), BF
    If bestPct(levelNum) > 0 Then
        Line (bx + bw * bestPct(levelNum) / 100, 9)-Step(1, 13), _RGB32(255, 210, 60), BF
    End If
    If muted Then textAt "muted", SW - 10 - _PrintWidth("muted"), 26, _RGB32(255, 255, 255)
End Sub

Sub drawTitle
    dimScreen 90
    bigText "LEAP LINE", SW / 2, 110, 6, _RGB32(255, 255, 255)
    centerText "Tap to hop, hold to jump higher. Don't stop, don't fall.", 175, _RGB32(255, 255, 255)
    centerText "<  " + levelLabel(titleLevel) + "  >", 250, _RGB32(255, 230, 120)
    If bestPct(titleLevel) > 0 Then centerText "best:" + Str$(bestPct(titleLevel)) + "%", 272, _RGB32(255, 255, 255)
    If levelCount > 1 Then centerText "levels played:" + Str$(unlockedCount) + " of" + Str$(levelCount), 292, _RGBA32(255, 255, 255, 160)
    If (frameCount \ 30) Mod 2 = 0 Then centerText "SPACE / click / tap to play", 320, _RGB32(255, 255, 255)
    If freeMove Then
        centerText "F free move: ON  (arrows / A D walk, SPACE jump, up / W enter portals)", 360, _RGB32(150, 250, 170)
    Else
        centerText "F free move: off", 360, _RGBA32(255, 255, 255, 150)
    End If
    centerText "R restart   M mute   ESC menu", SH - 30, _RGBA32(255, 255, 255, 180)
End Sub

Sub drawDeadScreen
    Dim s As String
    dimScreen 110
    bigText LTrim$(Str$(lastPct)) + "%", SW / 2, 150, 7, _RGB32(255, 255, 255)
    Select Case deathCause
        Case DIE_CRASH: s = "Bonk! Hit a wall."
        Case DIE_SPIKE: s = "Ouch! Spikes."
        Case DIE_LAVA
            If th.jungle Then s = "Stuck in the tar!" Else s = "Too hot!"
        Case DIE_CROC: s = "Chomp! Wait for the jaws to shut, or stand on the head."
        Case DIE_WATER
            If th.hotSea Then s = "Too hot!" Else s = "Splash!"
    End Select
    centerText s, 225, _RGB32(255, 230, 120)
    centerText "best:" + Str$(bestPct(levelNum)) + "%    attempt" + Str$(attempt), 255, _RGB32(255, 255, 255)
    If stateTicks > 15 Then centerText "SPACE / click to retry", 300, _RGB32(255, 255, 255)
End Sub

Sub drawWonScreen
    dimScreen 90
    bigText "COMPLETE!", SW / 2, 140, 5, _RGB32(255, 230, 90)
    centerText "Deaths on this level:" + Str$(levelDeaths), 210, _RGB32(255, 255, 255)
    If stateTicks > 40 Then
        If levelNum < levelCount Then
            centerText "SPACE / click for level" + Str$(levelNum + 1), 260, _RGB32(255, 255, 255)
        Else
            centerText "SPACE / click to finish", 260, _RGB32(255, 255, 255)
        End If
    End If
End Sub

Sub drawEndScreen
    dimScreen 140
    bigText "ALL CLEAR", SW / 2, 140, 6, _RGB32(255, 230, 90)
    centerText "Total deaths:" + Str$(deathsTotal), 220, _RGB32(255, 255, 255)
    If stateTicks > 40 Then centerText "SPACE / click for the title screen", 270, _RGB32(255, 255, 255)
End Sub

'--- sound: soft WAV effects, loaded the same way in QB64-PE and QBJS.
' A missing file just means that effect stays silent.

Sub loadSounds
    Dim names(1 To 10) As String, i As Long
    names(1) = "jump": names(2) = "airjump": names(3) = "flap"
    names(4) = "gem": names(5) = "switch": names(6) = "teleport"
    names(7) = "mode": names(8) = "die": names(9) = "win"
    names(10) = "arrive"
    For i = 1 To 10
$If WEB Then
$Else
        makeSoundIfMissing names(i)
$End If
        sounds(i) = _SndOpen(sfxPath(names(i)))
    Next
    For i = 0 To 4
$If WEB Then
$Else
        makeMusicIfMissing i
$End If
        music(i) = _SndOpen(sfxPath("music" + LTrim$(Str$(i))))
    Next
$If WEB Then
$Else
    makeVictoryIfMissing
$End If
    victorySong = _SndOpen(sfxPath("victory"))
End Sub

' The current level's theme tune loops while you play (and on the title
' screen, for the level picked there). Dying stops it, and the next attempt
' starts it over from the top (_SndStop rewinds). Winning swaps it for the
' victory song, which plays once and is cut short if you move on before it
' ends. M mutes it all along with everything else.
Sub updateMusic
    Static playing As Long ' theme + 1 of the tune playing, 0 = none
    Static cheering As Long ' the victory song is playing
    Dim want As Long, won As Long
    won = (gameState = ST_WON Or gameState = ST_END) And Not muted And Not headless And victorySong > 0
    If won <> cheering Then
        If won Then _SndPlay victorySong Else _SndStop victorySong
        cheering = won
    End If
    want = 0
    If Not muted And Not headless And gameState <> ST_END And gameState <> ST_DEAD And gameState <> ST_WON Then
        If music(levelTheme) > 0 Then want = levelTheme + 1
    End If
$If WEB Then
    ' browsers only start sound after a click or key, so wait for the first level
    If gameState = ST_TITLE And playing = 0 Then want = 0
$End If
    If want = playing Then Exit Sub
    If playing > 0 Then _SndStop music(playing - 1)
    If want > 0 Then _SndLoop music(want - 1)
    playing = want
End Sub

$If WEB Then
$Else
'--- native only (QBJS still compiles these subs but never calls them, as
' it can't write files): the sounds are generated here, so a native build doesn't
' need sfx/ shipped with it; any missing WAV is written on startup. To change
' a sound, edit its numbers below, delete its file and run the game. (QBJS
' loads the committed WAVs instead, see sfxPath.)
'
' Each sound is a sum of soft sine "voices": a pitch glide with a smooth
' attack and an exponential fade, kept quiet (peaks well below full scale).
Sub makeSoundIfMissing (n As String)
    Dim buf(0) As Single, f As String
    f = "sfx/" + n + ".wav"
    If _FileExists(f) Then Exit Sub
    If Not _DirExists("sfx") Then MkDir "sfx"
    ' voices: start Hz, end Hz, delay s, length s, volume
    Select Case n
        Case "jump"
            sndNew buf(), .12: sndVoice buf(), 330, 560, 0, .1, .22: sndVoice buf(), 660, 1120, 0, .06, .05
        Case "airjump"
            sndNew buf(), .14: sndVoice buf(), 520, 860, 0, .12, .18: sndVoice buf(), 1040, 1720, .01, .08, .05
        Case "flap"
            sndNew buf(), .08: sndVoice buf(), 230, 320, 0, .07, .14
        Case "gem"
            sndNew buf(), .3: sndVoice buf(), 1318, 1318, 0, .22, .12: sndVoice buf(), 1760, 1760, .06, .24, .1
        Case "switch"
            sndNew buf(), .2: sndVoice buf(), 440, 440, 0, .09, .14: sndVoice buf(), 660, 660, .08, .12, .14
        Case "teleport"
            sndNew buf(), .3: sndVoice buf(), 300, 1200, 0, .28, .12: sndVoice buf(), 450, 1800, .02, .24, .04
        Case "arrive"
            sndNew buf(), .3: sndVoice buf(), 1200, 300, 0, .26, .1: sndVoice buf(), 1800, 450, .02, .22, .03
        Case "mode"
            sndNew buf(), .25: sndVoice buf(), 660, 660, 0, .08, .1: sndVoice buf(), 880, 880, .06, .08, .1: sndVoice buf(), 1100, 1100, .12, .12, .1
        Case "die"
            sndNew buf(), .4: sndVoice buf(), 420, 110, 0, .36, .24: sndVoice buf(), 210, 70, .02, .34, .1
        Case "win"
            sndNew buf(), .7: sndVoice buf(), 523, 523, 0, .25, .14: sndVoice buf(), 659, 659, .1, .25, .14
            sndVoice buf(), 784, 784, .2, .25, .14: sndVoice buf(), 1046, 1046, .3, .38, .14
        Case Else
            Exit Sub
    End Select
    sndSaveWav buf(), f
End Sub

' Theme tunes: a melody over a chord per bar, from which a bass line and an
' arpeggio are made with a per-theme rhythm, plus soft drums. Eight bars of
' eighth notes that loop seamlessly (note tails wrap round to the start).
'   melody: note:eighths, e.g. "F#5:2" (b for flat, R for a rest)
'   chords: one per bar, e.g. "Am", "Eb"
'   patterns, one char per eighth (- holds): bass R root, F fifth, O octave;
'   arpeggio 0 1 2 = chord tones; drums K kick, H hat, B both
Sub makeMusicIfMissing (n As Long)
    Dim buf(0) As Single, f As String, bpm As Single, chords As String, mel As String
    Dim bassPat As String, arpPat As String, drumPat As String, lead As Long, leadVol As Single
    Dim e8 As Long, total As Long, bar As Long, st As Long, ch As String, d As Long, k As Long
    Dim root As Long, minor As Long, tok As String, nt As Long, at8 As Long, q As Long
    Dim i As Long, peak As Single
    f = "sfx/music" + LTrim$(Str$(n)) + ".wav"
    If _FileExists(f) Then Exit Sub
    If Not _DirExists("sfx") Then MkDir "sfx"
    Select Case n
        Case 0 ' meadow: bright and bouncy
            bpm = 132: lead = 1: leadVol = .26
            chords = "C G Am F C F Dm G"
            mel = "E5:2 G5:2 C6:2 G5:2 D5:2 G5:2 B5:3 A5:1 C6:2 B5:1 A5:1 E5:4 F5:2 A5:2 G5:2 F5:2 "
            mel = mel + "E5:2 G5:2 C6:3 D6:1 C6:2 A5:2 F5:4 D5:2 F5:2 A5:2 C6:2 B5:4 G5:2 R:2"
            bassPat = "R-F-O-F-": arpPat = "0121-121": drumPat = "K-H-K-H-"
        Case 1 ' dusk: mellow, minor
            bpm = 104: lead = 1: leadVol = .24
            chords = "Am F C G Am F Dm E"
            mel = "A4:3 C5:1 E5:4 F5:2 E5:2 C5:4 E5:3 D5:1 C5:2 G4:2 B4:2 D5:2 G4:4 "
            mel = mel + "A4:2 E5:2 A5:3 G5:1 F5:3 E5:1 C5:4 D5:2 F5:2 A5:2 F5:2 G#5:4 E5:2 B4:2"
            bassPat = "R---F---": arpPat = "0-1-2-1-": drumPat = "K-H---H-"
        Case 2 ' desert: plucked, a little exotic
            bpm = 120: lead = 3: leadVol = .3
            chords = "D Eb D Cm D Eb Cm D"
            mel = "D5:1 Eb5:1 F#5:2 A5:2 F#5:2 G5:2 F#5:1 Eb5:1 D5:4 A4:2 D5:2 F#5:2 A5:2 G5:3 Eb5:1 C5:4 "
            mel = mel + "D5:1 Eb5:1 F#5:2 G5:2 A5:2 Bb5:2 A5:1 G5:1 F#5:2 Eb5:2 G5:2 Eb5:2 C5:2 Eb5:2 D5:6 R:2"
            bassPat = "R--R--F-": arpPat = "--------": drumPat = "K--K--H-"
        Case 3 ' night: slow bells
            bpm = 92: lead = 4: leadVol = .22
            chords = "Em C G D Em C Am B"
            mel = "B4:4 E5:4 G5:6 E5:2 D5:4 B4:4 A4:6 R:2 B4:2 E5:2 G5:2 B5:2 C6:4 G5:4 A5:3 G5:1 E5:4 D#5:6 R:2"
            bassPat = "R-------": arpPat = "0-2-1-2-": drumPat = "--------"
        Case 4 ' jungle: marimba and drums
            bpm = 116: lead = 5: leadVol = .3
            chords = "Am G Am G F G Am E"
            mel = "A4:1 C5:1 R:1 E5:1 D5:1 C5:1 A4:2 G4:1 B4:1 R:1 D5:1 E5:2 D5:2 A4:1 C5:1 R:1 E5:1 G5:1 E5:1 D5:2 "
            mel = mel + "D5:1 E5:1 D5:1 B4:1 G4:4 A4:1 C5:1 F5:2 E5:1 C5:1 A4:2 B4:1 D5:1 G5:2 E5:1 D5:1 B4:2 "
            mel = mel + "C5:1 E5:1 A5:2 G5:1 E5:1 D5:1 C5:1 B4:2 G#4:2 E4:2 R:2"
            bassPat = "R--RF-R-": arpPat = "--------": drumPat = "K-HK-HH-"
        Case Else
            Exit Sub
    End Select

    e8 = Int(60 / bpm / 2 * SND_RATE) ' samples per eighth
    total = 64 * e8
    ReDim buf(0 To total - 1) As Single

    For bar = 0 To 7
        tok = wordOf(chords, bar)
        root = noteSemi(tok): minor = (Right$(tok, 1) = "m")
        For st = 0 To 7
            at8 = (bar * 8 + st) * e8
            ' how long until the next step in this bar that isn't "-"
            d = 1
            Do While st + d < 8
                If Mid$(bassPat, st + d + 1, 1) <> "-" Then Exit Do
                d = d + 1
            Loop
            ch = Mid$(bassPat, st + 1, 1)
            k = 36 + root
            If ch = "F" Then k = k + 7
            If ch = "O" Then k = k + 12
            If ch <> "-" Then musNote buf(), at8, k, d * e8, .3, 2
            ch = Mid$(arpPat, st + 1, 1)
            If ch <> "-" Then
                d = 1
                Do While st + d < 8
                    If Mid$(arpPat, st + d + 1, 1) <> "-" Then Exit Do
                    d = d + 1
                Loop
                k = 60 + root
                If ch = "1" Then k = k + 4 + minor ' minor is -1 when true
                If ch = "2" Then k = k + 7
                musNote buf(), at8, k, d * e8, .11, 3
            End If
            ch = Mid$(drumPat, st + 1, 1)
            If ch = "K" Or ch = "B" Then musNote buf(), at8, 0, e8, .32, 6
            If ch = "H" Or ch = "B" Then musNote buf(), at8, 0, e8, .05, 7
        Next
    Next

    at8 = 0: i = 0
    Do
        tok = wordOf(mel, i)
        If tok = "" Then Exit Do
        q = InStr(tok, ":")
        d = Val(Mid$(tok, q + 1))
        If Left$(tok, 1) <> "R" Then
            nt = noteSemi(Left$(tok, q - 1)) + 12 * (Val(Mid$(tok, q - 1, 1)) + 1)
            musNote buf(), at8 * e8, nt, d * e8, leadVol, lead
        End If
        at8 = at8 + d: i = i + 1
    Loop

    ' quieter than the sound effects
    For i = 0 To total - 1
        If Abs(buf(i)) > peak Then peak = Abs(buf(i))
    Next
    If peak > 0 Then
        For i = 0 To total - 1: buf(i) = buf(i) * .17 / peak: Next
    End If
    sndSaveWav buf(), f
End Sub

' The victory song: a short fanfare over C - F G - C, in the theme tunes'
' instruments, ending on a ringing chord. Not a loop, so the buffer runs on
' past the last note to let it fade.
Sub makeVictoryIfMissing
    Dim buf(0) As Single, f As String, e8 As Long, mel As String, tok As String
    Dim i As Long, q As Long, d As Long, at8 As Long, nt As Long, peak As Single
    f = "sfx/victory.wav"
    If _FileExists(f) Then Exit Sub
    If Not _DirExists("sfx") Then MkDir "sfx"
    e8 = Int(60 / 150 / 2 * SND_RATE) ' 150 bpm
    ReDim buf(0 To 30 * e8 - 1) As Single

    ' melody, soft lead doubled an octave up by a quiet bell
    mel = "G4:1 C5:1 E5:1 G5:3 E5:1 G5:1 A5:2 F5:1 A5:1 G5:2 D5:1 B4:1 C6:8"
    Do
        tok = wordOf(mel, i)
        If tok = "" Then Exit Do
        q = InStr(tok, ":")
        d = Val(Mid$(tok, q + 1))
        nt = noteSemi(Left$(tok, q - 1)) + 12 * (Val(Mid$(tok, q - 1, 1)) + 1)
        musNote buf(), at8 * e8, nt, d * e8, .28, 1
        musNote buf(), at8 * e8, nt + 12, d * e8, .05, 4
        at8 = at8 + d: i = i + 1
    Loop

    ' bass: C, then F and G, then a long low C
    musNote buf(), 0, 36, 3 * e8, .32, 2: musNote buf(), 3 * e8, 43, 3 * e8, .28, 2
    musNote buf(), 6 * e8, 36, 2 * e8, .3, 2
    musNote buf(), 8 * e8, 41, 4 * e8, .32, 2: musNote buf(), 12 * e8, 43, 4 * e8, .32, 2
    musNote buf(), 16 * e8, 36, 8 * e8, .36, 2
    ' plucked chord stabs, then the final chord on bells
    musNote buf(), 3 * e8, 64, e8, .1, 3: musNote buf(), 3 * e8, 67, e8, .1, 3
    musNote buf(), 10 * e8, 65, e8, .1, 3: musNote buf(), 10 * e8, 69, e8, .1, 3
    musNote buf(), 14 * e8, 62, e8, .1, 3: musNote buf(), 14 * e8, 67, e8, .1, 3
    musNote buf(), 16 * e8, 60, 0, .12, 4: musNote buf(), 16 * e8, 64, 0, .12, 4
    musNote buf(), 16 * e8, 67, 0, .12, 4
    ' drums: kick on the beats, a pickup roll into the last chord
    For i = 0 To 14 Step 2: musNote buf(), i * e8, 0, e8, .3, 6: Next
    musNote buf(), 15 * e8, 0, e8, .22, 6
    musNote buf(), 16 * e8, 0, e8, .4, 6: musNote buf(), 16 * e8, 0, e8, .08, 7

    ' a touch louder than the theme tunes, as it plays on its own
    For i = 0 To UBound(buf)
        If Abs(buf(i)) > peak Then peak = Abs(buf(i))
    Next
    If peak > 0 Then
        For i = 0 To UBound(buf): buf(i) = buf(i) * .22 / peak: Next
    End If
    sndSaveWav buf(), f
End Sub

' Word i (from 0) of a space-separated list, "" past the end.
Function wordOf$ (s As String, i As Long)
    Dim a As Long, b As Long, n As Long
    a = 1
    For n = 1 To i
        a = InStr(a, s, " ")
        If a = 0 Then Exit Function
        a = a + 1
    Next
    b = InStr(a, s, " ")
    If b = 0 Then b = Len(s) + 1
    wordOf$ = Mid$(s, a, b - a)
End Function

' Semitone of a note or chord name above C: "C" 0, "F#" 6, "Bb" 10.
Function noteSemi& (s As String)
    Dim k As Long
    k = InStr("C D EF G A B", Left$(s, 1)) - 1
    If Mid$(s, 2, 1) = "#" Then k = k + 1
    If Mid$(s, 2, 1) = "b" Then k = k - 1
    noteSemi& = (k + 12) Mod 12
End Function

' One note into a looping buffer, starting at sample st and held for dur
' samples (plucked sounds ring on regardless). k is a MIDI note number.
' Instruments: 1 soft lead (a few harmonics, slight vibrato), 2 round bass,
' 3 pluck, 4 bell, 5 marimba, 6 kick, 7 hat (filtered noise).
Sub musNote (buf() As Single, st As Long, k As Long, dur As Long, vol As Single, inst As Long)
    Dim i As Long, n As Long, total As Long, t As Single, env As Single, v As Single
    Dim hz As Single, ph As Double, f As Single, rel As Long, nz As Single, prev As Single
    total = UBound(buf) + 1
    hz = 440 * 2 ^ ((k - 69) / 12)
    rel = Int(.08 * SND_RATE)
    Select Case inst
        Case 1, 2: n = dur + rel
        Case 3: n = Int(.5 * SND_RATE)
        Case 4: n = Int(1.6 * SND_RATE)
        Case 5: n = Int(.6 * SND_RATE)
        Case 6: n = Int(.16 * SND_RATE)
        Case 7: n = Int(.05 * SND_RATE)
    End Select
    For i = 0 To n - 1
        t = i / SND_RATE
        Select Case inst
            Case 1
                f = hz * (1 + .004 * Sin(t * 31) * maxf(0, t - .15))
                ph = ph + 6.283185307 * f / SND_RATE
                v = Sin(ph) + .3 * Sin(2 * ph) + .12 * Sin(3 * ph)
                env = .6 + .4 * Exp(-t * 6)
                If i < 300 Then env = env * i / 300
                If i > dur Then env = env * (1 - (i - dur) / rel)
            Case 2
                ph = ph + 6.283185307 * hz / SND_RATE
                v = Sin(ph) - Sin(3 * ph) / 9 + Sin(5 * ph) / 25
                env = .5 + .5 * Exp(-t * 5)
                If i < 200 Then env = env * i / 200
                If i > dur Then env = env * (1 - (i - dur) / rel)
            Case 3
                ph = ph + 6.283185307 * hz / SND_RATE
                v = Sin(ph) + .25 * Sin(2 * ph) * Exp(-t * 12)
                env = Exp(-t * 7)
                If i < 80 Then env = env * i / 80
            Case 4
                ph = ph + 6.283185307 * hz / SND_RATE
                v = Sin(ph) + .3 * Sin(2.76 * ph) * Exp(-t * 4) + .12 * Sin(5.4 * ph) * Exp(-t * 9)
                env = Exp(-t * 2.4)
                If i < 120 Then env = env * i / 120
            Case 5
                ph = ph + 6.283185307 * hz / SND_RATE
                v = Sin(ph) + .35 * Sin(4 * ph) * Exp(-t * 30)
                env = Exp(-t * 7)
                If i < 60 Then env = env * i / 60
            Case 6
                f = 45 + 75 * Exp(-t * 30)
                ph = ph + 6.283185307 * f / SND_RATE
                v = Sin(ph)
                env = Exp(-t * 18)
                If i < 40 Then env = env * i / 40
            Case 7
                nz = Rnd * 2 - 1
                v = nz - prev: prev = nz
                env = Exp(-t * 70)
        End Select
        env = env * (1 - i / n) ' always fade to silence, no clicks
        buf((st + i) Mod total) = buf((st + i) Mod total) + v * env * vol
    Next
End Sub

Sub sndNew (buf() As Single, seconds As Single)
    ReDim buf(0 To Int(seconds * SND_RATE) - 1) As Single
End Sub

' One soft sine tone gliding from f1 to f2 Hz.
Sub sndVoice (buf() As Single, f1 As Single, f2 As Single, delay As Single, length As Single, vol As Single)
    Dim i As Long, n As Long, start As Long, t As Single, f As Single
    Dim phase As Double, env As Single
    Const ATTACK = .006
    start = Int(delay * SND_RATE)
    n = Int(length * SND_RATE)
    For i = 0 To n - 1
        If start + i > UBound(buf) Then Exit For
        t = i / SND_RATE
        f = f1 + (f2 - f1) * (i / n) ' linear glide
        phase = phase + 6.283185307 * f / SND_RATE
        If t < ATTACK Then env = t / ATTACK Else env = Exp(-5 * (t - ATTACK) / length)
        env = env * (1 - i / n) ' reach silence exactly at the end, no click
        buf(start + i) = buf(start + i) + Sin(phase) * env * vol
    Next
End Sub

' 16-bit mono WAV.
Sub sndSaveWav (buf() As Single, fileName As String)
    Dim i As Long, v As Long, d As String, h As String, ff As Long
    d = Space$(2 * (UBound(buf) + 1))
    For i = 0 To UBound(buf)
        v = buf(i) * 32767
        If v > 32767 Then v = 32767
        If v < -32768 Then v = -32768
        Mid$(d, 2 * i + 1, 2) = MKI$(v)
    Next
    h = "RIFF" + MKL$(36 + Len(d)) + "WAVE"
    h = h + "fmt " + MKL$(16) + MKI$(1) + MKI$(1) + MKL$(SND_RATE) + MKL$(SND_RATE * 2) + MKI$(2) + MKI$(16)
    h = h + "data" + MKL$(Len(d))
    ff = FreeFile
    Open fileName For Binary As #ff
    Put #ff, , h
    Put #ff, , d
    Close #ff
End Sub
$End If

' Native builds read sfx/ next to the program. In the browser (QBJS) the
' files come from the project if they were added to it, otherwise from the
' GitHub repo through jsDelivr, so sharing just the .bas still has sound.
' The link is pinned to the commit that last changed sfx/; update it (and
' push) after remaking the sounds.
Function sfxPath$ (n As String)
    sfxPath$ = "sfx/" + n + ".wav"
$If WEB Then
    If Not _FileExists(sfxPath$) Then
        sfxPath$ = "https://cdn.jsdelivr.net/gh/FellippeHeitor/Platform@1bacff584aa00892d42c18f800a054c05e8cf102/sfx/" + n + ".wav"
    End If
$End If
End Function

Sub sfx (n As Long)
    If muted Or headless Then Exit Sub
    If sounds(n) <= 0 Then Exit Sub
    ' a copy lets the same sound overlap itself; QBJS releases before
    ' 2026-10-20 lack _SndPlayCopy, so the browser just restarts the sound
$If WEB Then
    _SndPlay sounds(n)
$Else
    _SndPlayCopy sounds(n)
$End If
End Sub
