$If HEADLESS = 1 Then
    runLevelCheck ' see levelcheck.bas
$End If

Screen _NewImage(SW, SH, 32)
_Title "Leap Line"
initThemes
initHeroSprites
initSprites
loadSounds
loadProgress
seedProgress Command$
titleLevel = 1
loadLevel titleLevel
gameState = ST_TITLE

Dim held As Long, heldFrame As Long, pressLatch As Long, k As Long, upPrev As Long, doorLatch As Long
Dim lastTime As Double, now As Double, acc As Double, dt As Double
lastTime = Timer(.001)

Do
    ' input: any of space, mouse button or touch. Latch presses so a tap that
    ' starts and ends between two physics ticks is still seen.
    While _MouseInput: Wend
    heldFrame = (_MouseButton(1) <> 0) Or _KeyDown(32)
    moveDir = 0
    If freeMove Then
        ' up / W: enter a portal (latched, like jump presses)
        If _KeyDown(18432) Or _KeyDown(119) Or _KeyDown(87) Then
            If Not upPrev Then doorLatch = TRUE
            upPrev = TRUE
        Else
            upPrev = FALSE
        End If
        If _KeyDown(19200) Or _KeyDown(97) Or _KeyDown(65) Then moveDir = moveDir - 1
        If _KeyDown(19712) Or _KeyDown(100) Or _KeyDown(68) Then moveDir = moveDir + 1
    End If
    If heldFrame Then pressLatch = TRUE

    k = _KeyHit
    Select Case k
        Case 27
            If gameState = ST_TITLE Then System
            gameState = ST_TITLE
            loadLevel titleLevel
        Case 70, 102 ' F
            If gameState = ST_TITLE Then freeMove = Not freeMove
        Case 77, 109 ' M
            muted = Not muted
        Case 82, 114 ' R
            If gameState = ST_PLAY Or gameState = ST_DEAD Then resetAttempt
        Case 19200 ' left
            If gameState = ST_TITLE Then pickLevel -1
        Case 19712 ' right
            If gameState = ST_TITLE Then pickLevel 1
    End Select

    now = Timer(.001)
    dt = now - lastTime
    If dt < 0 Then dt = dt + 86400 ' midnight
    If dt > .25 Then dt = .25
    lastTime = now
    acc = acc + dt

    Do While acc >= STEP_DT
        held = heldFrame Or pressLatch
        pressLatch = FALSE
        doorPress = doorLatch: doorLatch = FALSE
        updateGame held
        doorPress = FALSE
        acc = acc - STEP_DT
    Loop

    updateMusic
    render
    _Display
    _Limit 120
Loop

