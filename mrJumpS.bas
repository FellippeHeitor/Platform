' Hero frames, drawn smooth like the other sprites. Poses 0-5 run, 6 jump,
' 7 fall, 8 idle; each in HERO_SQ squash steps (squash and stretch is baked
' into the shapes rather than done by scaling, so the edges stay clean).
' Frame = pose * HERO_SQ + step. The feet touch the bottom middle of the image.
Sub initHeroSprites
    Dim pose As Long, q As Long
    For pose = 0 To 8
        For q = 0 To HERO_SQ - 1
            heroImg(pose * HERO_SQ + q) = makeHeroFrame(pose, (q - HERO_SQ \ 2) * .2)
            rawWrites heroImg(pose * HERO_SQ + q), FALSE
        Next
    Next
    sprPack = makePack
    rawWrites sprPack, FALSE
End Sub

' Ellipse distance (approximate away from the edge, which is all we need).
Function sdEllipse! (px As Single, py As Single, cx As Single, cy As Single, rx As Single, ry As Single)
    Dim u As Single, v As Single, m As Single
    u = (px - cx) / rx: v = (py - cy) / ry
    m = rx
    If ry < m Then m = ry
    sdEllipse! = (Sqr(u * u + v * v) - 1) * m
End Function

' Lighting for the hero's round shapes: 0 in shadow .. 1 fully lit (top left).
Function heroLight! (px As Single, py As Single, cx As Single, cy As Single, rx As Single, ry As Single)
    Dim nx As Single, ny As Single, t As Single, lam As Single
    nx = (px - cx) / rx: ny = (py - cy) / ry
    t = 1 - nx * nx - ny * ny
    If t < 0 Then t = 0
    lam = -.45 * nx - .55 * ny + .75 * Sqr(t)
    If lam < 0 Then lam = 0
    If lam > 1 Then lam = 1
    heroLight! = lam
End Function

' s > 0 squashes (wide, short), s < 0 stretches (tall, thin).
Function makeHeroFrame& (pose As Long, s As Single)
    Dim img As Long, px As Long, py As Long, X As Single, Y As Single, d As Single, e As Single
    Dim ink As _Unsigned Long, red As _Unsigned Long, redDark As _Unsigned Long
    Dim bx As Single, by As Single, rx As Single, ry As Single, bob As Single, lt As Single
    Dim f1x As Single, f1y As Single, f2x As Single, f2y As Single, ph As Single
    Dim a1 As Single, a2 As Single, eyeDy As Single, bandY As Single, bandH As Single
    Dim kx As Single, ky As Single, e1x As Single, e2x As Single, ey As Single
    Dim GY As Single
    GY = 28
    ink = _RGB32(34, 32, 52)
    red = _RGB32(240, 82, 78): redDark = _RGB32(150, 34, 50)

    ' pose: feet, body bob, headband tail angles (pi = straight back), gaze
    If pose <= 5 Then
        ph = pose / 6 * 6.2832
        f1x = 14 + 3.4 * Cos(ph): f1y = GY - 1.9 - 2.2 * maxf(0, Sin(ph))
        f2x = 14 - 3.4 * Cos(ph): f2y = GY - 1.9 - 2.2 * maxf(0, -Sin(ph))
        bob = .9 * Abs(Sin(ph))
        a1 = 3.1416 + .12 + .2 * Sin(ph * 2): a2 = 3.1416 - .28 + .2 * Sin(ph * 2 + 1.3)
        eyeDy = 0
    ElseIf pose = 6 Then ' rising: feet tucked, tails pulled down, looking up
        f1x = 15.5: f1y = GY - 3.6: f2x = 11: f2y = GY - 2.6
        bob = 1: a1 = 3.1416 - .55: a2 = 3.1416 - .95: eyeDy = -1
    ElseIf pose = 7 Then ' falling: feet reaching down, tails up, looking down
        f1x = 17: f1y = GY - 2.2: f2x = 11.5: f2y = GY - 1.9
        bob = 0: a1 = 3.1416 + .6: a2 = 3.1416 + .25: eyeDy = .9
    Else ' idle
        f1x = 17: f1y = GY - 1.9: f2x = 11: f2y = GY - 1.9
        bob = 0: a1 = 3.1416 - .35: a2 = 3.1416 - .75: eyeDy = 0
    End If

    rx = 8 * (1 + s * .3): ry = 7.6 * (1 - s * .25)
    bx = 14.5: by = GY - 3 - ry - bob
    bandY = by - ry * .55: bandH = 1.9 * (ry / 7.6)
    kx = bx - rx + 1.2: ky = bandY + .3 ' headband knot at the back
    ey = by + .3 * (ry / 7.6) + eyeDy
    e1x = bx + rx * .2: e2x = bx + rx * .6

    img = newSprite(28, GY)
    For py = 0 To GY - 1
        For px = 0 To 27
            X = px + .5: Y = py + .5
            pxBegin
            ' headband tails, back one first
            d = sdFeather(X, Y, kx, ky, a2, 6, 1.5)
            pxLayer ink, cov(d - .5): pxLayer redDark, cov(d + .6)
            d = sdFeather(X, Y, kx, ky, a1, 7.5, 1.7)
            pxLayer ink, cov(d - .5): pxLayer mixColor(redDark, red, .55), cov(d + .6)
            ' feet, behind the body
            d = sdEllipse(X, Y, f2x, f2y, 2.9, 2)
            pxLayer ink, cov(d): pxLayer _RGB32(58, 56, 84), cov(d + 1)
            d = sdEllipse(X, Y, f1x, f1y, 2.9, 2)
            pxLayer ink, cov(d): pxLayer mixColor(_RGB32(58, 56, 84), _RGB32(104, 100, 140), (f1y - Y + 1) / 3), cov(d + 1)
            ' body
            d = sdEllipse(X, Y, bx, by, rx, ry)
            pxLayer ink, cov(d)
            lt = heroLight(X, Y, bx, by, rx, ry)
            pxLayer mixColor(_RGB32(172, 166, 206), _RGB32(255, 253, 246), .15 + lt * 1.1), cov(d + 1.1)
            ' headband, clipped to the body
            e = Abs(Y - bandY + (X - bx) * .06) - bandH
            If d + 1.1 > e Then e = d + 1.1
            pxLayer mixColor(redDark, red, .2 + lt * 1.1), cov(e)
            pxLayer _RGBA32(255, 220, 210, 150), cov(Abs(Y - (bandY - bandH * .45) + (X - bx) * .06) - .35) * cov(d + 1.6) * lt
            ' knot
            d = sdCircle(X, Y, kx, ky, 1.9)
            pxLayer ink, cov(d): pxLayer mixColor(redDark, red, .5), cov(d + .9)
            ' eyes: the far one narrower, each with a catchlight
            d = sdEllipse(X, Y, e1x, ey, 1.55, 2.6 * (ry / 7.6))
            pxLayer ink, cov(d)
            d = sdEllipse(X, Y, e2x, ey, 1.2, 2.45 * (ry / 7.6))
            pxLayer ink, cov(d)
            pxLayer _RGB32(255, 255, 255), cov(sdCircle(X, Y, e1x + .45, ey - 1.1, .5))
            pxLayer _RGB32(255, 255, 255), cov(sdCircle(X, Y, e2x + .35, ey - 1.1, .4))
            ' cheek
            pxLayer _RGBA32(255, 120, 140, 110), cov(sdEllipse(X, Y, bx + rx * .5, ey + 3.1, 1.6, 1.1))
            pxEnd px, py
        Next
    Next
    _Dest 0
    makeHeroFrame& = img
End Function

' The jetpack the hero wears: a canister with a nozzle, lit from the left.
Function makePack&
    Dim img As Long, px As Long, py As Long, X As Single, Y As Single, d As Single
    Dim ink As _Unsigned Long
    ink = _RGB32(40, 40, 58)
    img = newSprite(9, 14)
    For py = 0 To 13
        For px = 0 To 8
            X = px + .5: Y = py + .5
            pxBegin
            d = sdBox(X, Y, 4.5, 6, 4, 5.5, 2.2)
            pxLayer ink, cov(d)
            pxLayer mixColor(_RGB32(220, 222, 236), _RGB32(120, 122, 146), (X - 1.5) / 6), cov(d + 1)
            pxLayer _RGB32(255, 138, 48), cov(Abs(Y - 5) - .9) * cov(d + 1.5)
            d = sdBox(X, Y, 4.5, 12.3, 2.3, 1.4, .5)
            pxLayer ink, cov(d): pxLayer _RGB32(96, 98, 120), cov(d + 1)
            pxEnd px, py
        Next
    Next
    _Dest 0
    makePack& = img
End Function

Function maxf! (a As Single, b As Single)
    If a > b Then maxf! = a Else maxf! = b
End Function

Function mixColor~& (a As _Unsigned Long, b As _Unsigned Long, tt As Single)
    Dim t As Single
    t = tt
    If t < 0 Then t = 0
    If t > 1 Then t = 1
    mixColor~& = _RGB32(_Red32(a) + (_Red32(b) - _Red32(a)) * t, _Green32(a) + (_Green32(b) - _Green32(a)) * t, _Blue32(a) + (_Blue32(b) - _Blue32(a)) * t)
End Function

Function shade~& (c As _Unsigned Long, f As Single)
    Dim r As Single, g As Single, b As Single
    r = _Red32(c) * f: g = _Green32(c) * f: b = _Blue32(c) * f
    If r > 255 Then r = 255
    If g > 255 Then g = 255
    If b > 255 Then b = 255
    shade~& = _RGB32(r, g, b)
End Function

' Cheap deterministic noise so baked textures look the same every time.
Function hash01! (a As Long, b As Long)
    Dim v As Long
    v = (a * 73 + b * 151 + a * b * 7) Mod 997
    hash01! = v / 997
End Function

' Triangle with its tip at (cx, peakY) and a flat base at baseY (either side).
Sub fillCircle (cx As Single, cy As Single, r As Single, c As _Unsigned Long)
    Dim y As Long, w As Single
    For y = Int(cy - r) To Int(cy + r)
        w = r * r - (y - cy) * (y - cy)
        If w > 0 Then w = Sqr(w): Line (cx - w, y)-(cx + w, y), c
    Next
End Sub

' Jungle backdrop: rows of tree trunks under a leafy canopy, in the same two
' wrapping parallax strips the hills use (drawn at x, x - 2 screens and
' x + 2 screens so the wrap is seamless).
Sub bakeJungle
    Dim i As Long, k As Long, x As Single, w As Single, img As Long, col As _Unsigned Long, dk As _Unsigned Long
    For k = 0 To 1
        img = _NewImage(SW * 2, SH, 32)
        _Dest img
        If k = 0 Then col = th.hillFar Else col = th.hillNear
        dk = shade(col, .75)
        For i = 0 To 11 + k * 4
            x = i * SW * 2 / (12 + k * 4) + hash01(i, 21 + k) * 60
            w = 10 + hash01(i, 23 + k) * 12 + k * 10
            jungleTrunk x, w, col, dk
            jungleTrunk x - SW * 2, w, col, dk
            jungleTrunk x + SW * 2, w, col, dk
        Next
        ' canopy along the top
        For i = 0 To 40
            x = i * SW * 2 / 40
            w = 30 + hash01(i, 31 + k) * 30 + k * 10
            fillCircle x, 10 + k * 20 + hash01(i, 33 + k) * 40, w, shade(col, 1.15 - k * .1)
            fillCircle x - SW * 2, 10 + k * 20 + hash01(i, 33 + k) * 40, w, shade(col, 1.15 - k * .1)
            fillCircle x + SW * 2, 10 + k * 20 + hash01(i, 33 + k) * 40, w, shade(col, 1.15 - k * .1)
        Next
        If k = 0 Then farImg = img Else nearImg = img
    Next
    _Dest 0
End Sub

Sub jungleTrunk (x As Single, w As Single, col As _Unsigned Long, dk As _Unsigned Long)
    Line (x, 0)-Step(w, SH), col, BF
    Line (x + w * .65, 0)-Step(w * .35, SH), dk, BF
    ' roots
    fillTri x + w / 2, SH - 30, w * .9, SH, col
End Sub

Sub fillTri (cx As Single, peakY As Single, halfW As Single, baseY As Single, c As _Unsigned Long)
    Dim y As Long, w As Single, y1 As Long, y2 As Long
    If baseY >= peakY Then y1 = Int(peakY): y2 = Int(baseY) Else y1 = Int(baseY): y2 = Int(peakY)
    For y = y1 To y2
        w = halfW * Abs(y - peakY) / (Abs(baseY - peakY) + .001)
        Line (cx - w, y)-(cx + w, y), c
    Next
End Sub

Sub bakeBackground
    Dim y As Long, i As Long, x As Single, h As Single, w As Single

    If skyImg <> 0 Then _FreeImage skyImg
    skyImg = _NewImage(SW, SH, 32)
    _Dest skyImg
    For y = 0 To SH - 1
        Line (0, y)-(SW - 1, y), mixColor(th.skyTop, th.skyBottom, y / SH)
    Next
    If th.stars Then
        For i = 1 To 90
            PSet (hash01(i, 3) * SW, hash01(i, 11) * SH * .6), _RGBA32(255, 255, 255, 80 + hash01(i, 5) * 170)
        Next
    End If

    If th.jungle Then
        If farImg <> 0 Then _FreeImage farImg
        If nearImg <> 0 Then _FreeImage nearImg
        bakeJungle
        Exit Sub
    End If

    ' hill strips are 2 screens wide and wrap seamlessly
    If farImg <> 0 Then _FreeImage farImg
    farImg = _NewImage(SW * 2, SH, 32)
    _Dest farImg
    For i = 0 To 9
        x = i * SW * 2 / 10 + hash01(i, 1) * 80
        h = 140 + hash01(i, 2) * 120
        w = 160 + hash01(i, 4) * 120
        fillTri x, SH - h - 40, w, SH, th.hillFar
        fillTri x + SW * 2, SH - h - 40, w, SH, th.hillFar
        fillTri x - SW * 2, SH - h - 40, w, SH, th.hillFar
    Next
    If nearImg <> 0 Then _FreeImage nearImg
    nearImg = _NewImage(SW * 2, SH, 32)
    _Dest nearImg
    For i = 0 To 13
        x = i * SW * 2 / 14 + hash01(i, 7) * 60
        h = 80 + hash01(i, 8) * 90
        w = 110 + hash01(i, 9) * 90
        fillTri x, SH - h, w, SH, th.hillNear
        fillTri x + SW * 2, SH - h, w, SH, th.hillNear
        fillTri x - SW * 2, SH - h, w, SH, th.hillNear
    Next
    _Dest 0
End Sub

Sub initClouds
    Dim i As Long
    For i = 1 To 8
        clouds(i).x = Rnd * SW * 2
        clouds(i).y = 20 + Rnd * 160
        clouds(i).w = 60 + Rnd * 100
        clouds(i).speed = .1 + Rnd * .3
    Next
End Sub

' Static tiles are drawn once into a level-sized image.
Sub bakeLevel
    Dim c As Long, r As Long, t As Long, x As Long, y As Long, i As Long

    If levelImg <> 0 Then _FreeImage levelImg
    levelImg = _NewImage(levelCols * TILE, SH, 32)
    rawWrites levelImg, TRUE
    _Dest levelImg
    For c = 0 To levelCols - 1
        For r = 0 To ROWS - 1
            t = tiles(c, r)
            x = c * TILE: y = r * TILE
            Select Case t
                Case T_GROUND
                    Line (x, y)-Step(TILE - 1, TILE - 1), th.ground, BF
                    For i = 0 To 2
                        Line (x + 3 + hash01(c, r * 3 + i) * 17, y + 4 + hash01(r, c * 5 + i) * 16)-Step(2, 2), th.groundDark, BF
                    Next
                    If tileAt(c - 1, r) <> T_GROUND Then Line (x, y)-Step(2, TILE - 1), shade(th.ground, 1.15), BF
                    If tileAt(c + 1, r) <> T_GROUND Then Line (x + TILE - 3, y)-Step(2, TILE - 1), th.groundDark, BF
                    If tileAt(c, r - 1) <> T_GROUND Then
                        Line (x, y)-Step(TILE - 1, 6), th.grass, BF
                        Line (x, y)-Step(TILE - 1, 1), shade(th.grass, 1.25), BF
                        Line (x, y + 7)-Step(TILE - 1, 1), shade(th.grass, .7), BF
                    End If
                Case T_PLANK
                    Line (x, y)-Step(TILE - 1, 7), _RGB32(150, 98, 54), BF
                    Line (x, y)-Step(TILE - 1, 1), _RGB32(196, 140, 84), BF
                    Line (x, y + 6)-Step(TILE - 1, 1), _RGB32(96, 60, 34), BF
                    Line (x + TILE - 2, y)-Step(1, 7), _RGB32(96, 60, 34), BF
                Case T_SPIKE
                    _PutImage (x, y), sprSpikeUp
                Case T_SPIKEDOWN
                    _PutImage (x, y), sprSpikeDown
                Case T_LAVA
                    ' the top of a pool is left open here: drawLiquidTop
                    ' draws its moving surface every frame
                    i = 0
                    If liquidSurface(c, r) Then i = LIQUID_TOP
                    If th.jungle Then ' tar pit
                        Line (x, y + i)-Step(TILE - 1, TILE - 1 - i), _RGB32(34, 30, 36), BF
                        If i Then Line (x + 4 + hash01(c, r) * 12, y + 10)-Step(3, 2), _RGB32(70, 64, 76), BF
                    Else
                        Line (x, y + i)-Step(TILE - 1, TILE - 1 - i), _RGB32(214, 64, 30), BF
                        Line (x, y + 9 + hash01(c, r) * 4)-Step(TILE - 1, 3), _RGB32(255, 168, 48), BF
                    End If
            End Select
        Next
    Next
    rawWrites levelImg, FALSE
    _Dest 0
End Sub

Sub render
    Dim cx As Long, ox As Long, oy As Long, i As Long, p As Single, sx As Single, sy As Single

    ox = 0: oy = 0
    If shake > 0 Then ox = (Rnd - .5) * shake * 2: oy = (Rnd - .5) * shake * 2
    cx = Int(camX)

    _PutImage (0, 0), skyImg
    drawParallax farImg, cx * .2
    drawClouds cx
    drawParallax nearImg, cx * .45
    _PutImage (ox, oy)-(ox + SW - 1, oy + SH - 1), levelImg, 0, (cx, 0)-(cx + SW - 1, SH - 1)
    drawVines cx - ox, oy
    drawDynamicTiles cx - ox, oy
    If gameState = ST_PLAY Or gameState = ST_DEAD Then drawAttemptMark cx - ox, oy
    If gameState <> ST_TITLE And hero.alive Then
        If teleT > 0 Then
            p = teleProgress
            If p < .3 Then
                ' beam out where the hero stepped in
                sx = hero.x: sy = hero.y
                hero.x = teleFromX: hero.y = teleFromY
                drawBeam cx - ox, oy, p / .3
                drawHero cx - ox, oy, 1 - p / .3
                hero.x = sx: hero.y = sy
            ElseIf p > .75 Then
                drawBeam cx - ox, oy, 1 - (p - .75) / .25
                drawHero cx - ox, oy, (p - .75) / .25
            End If
        Else
            drawHero cx - ox, oy, 1
        End If
    End If
    drawParticles cx - ox, oy
    drawWater cx
    If gameState = ST_PLAY And popLife > 0 Then drawPopup cx

    Select Case gameState
        Case ST_TITLE: drawTitle
        Case ST_PLAY: drawHud
        Case ST_DEAD: drawHud: drawDeadScreen
        Case ST_WON: drawHud: drawWonScreen
        Case ST_END: drawEndScreen
    End Select
End Sub

Sub drawParallax (img As Long, offset As Single)
    Dim o As Long
    o = Int(offset) Mod (SW * 2)
    _PutImage (-o, 0), img
    _PutImage (SW * 2 - o, 0), img
End Sub

Sub updateClouds
    Dim i As Long
    For i = 1 To 8
        clouds(i).x = clouds(i).x - clouds(i).speed
    Next
End Sub

Sub drawClouds (cx As Long)
    Dim i As Long, x As Single, w As Single
    If th.jungle Then Exit Sub ' no sky to see under the canopy
    For i = 1 To 8
        x = clouds(i).x - cx * .3
        x = x - Int(x / (SW * 2)) * SW * 2 - 200
        w = clouds(i).w
        Line (x, clouds(i).y)-Step(w, 14), _RGBA32(255, 255, 255, 70), BF
        Line (x + w * .15, clouds(i).y - 8)-Step(w * .5, 8), _RGBA32(255, 255, 255, 70), BF
        Line (x + w * .1, clouds(i).y + 14)-Step(w * .8, 6), _RGBA32(255, 255, 255, 40), BF
    Next
End Sub

Sub drawWater (cx As Long)
    Dim x As Long, y As Single
    Line (0, WATER_Y)-(SW - 1, SH - 1), _RGBA32(_Red32(th.water), _Green32(th.water), _Blue32(th.water), 210), BF
    For x = 0 To SW Step 16
        y = WATER_Y + Sin((x + cx + frameCount * 2) / 30) * 2
        Line (x, y)-Step(9, 1), _RGBA32(255, 255, 255, 110), BF
    Next
End Sub

Sub drawDynamicTiles (cx As Long, oy As Long)
    Dim c As Long, r As Long, t As Long, x As Single, y As Single
    Dim c1 As Long, c2 As Long, b As Single, p As Single

    c1 = Int(cx / TILE) - 1
    c2 = c1 + SW \ TILE + 3
    For c = c1 To c2
        For r = 0 To ROWS - 1
            t = tileAt(c, r)
            If t = T_LAVA Then
                If liquidSurface(c, r) Then drawLiquidTop c * TILE - cx, r * TILE + oy, c, r
            ElseIf t >= T_GEM Then
                x = c * TILE - cx: y = r * TILE + oy
                Select Case t
                    Case T_GEM
                        If (hero.gemMask And (2 ^ gemIndex(c, r))) = 0 Or gameState = ST_TITLE Then
                            b = Sin(frameCount / 10 + c) * 3
                            p = 1 + Sin(frameCount / 9 + c) * .1
                            putCentered glow(GLOW_CYAN), x + TILE / 2, y + TILE / 2 + b, p, p
                            putCentered sprGem, x + TILE / 2, y + TILE / 2 + b, 1, 1
                            twinkle x + TILE / 2 - 4, y + TILE / 2 + b - 6, (frameCount + c * 17) Mod 90
                        End If
                    Case T_FUEL
                        If (hero.gemMask And (2 ^ gemIndex(c, r))) = 0 Or gameState = ST_TITLE Then
                            b = Sin(frameCount / 11 + c) * 2
                            p = 1 + Sin(frameCount / 9 + c) * .1
                            putCentered glow(GLOW_ORANGE), x + TILE / 2, y + TILE / 2 + b, p * .8, p * .8
                            putCentered sprFuel, x + TILE / 2, y + TILE / 2 + b, 1, 1
                        End If
                    Case T_TOGGLEA, T_TOGGLEB
                        drawToggleSpike x, y, t
                    Case T_CROC
                        ' one sprite per croc, drawn from its left tile
                        If tileAt(c - 1, r) <> T_CROC Then _PutImage (x - 2, y - 20), sprCroc(crocFrame)
                    Case T_SWITCH
                        If (hero.openMask And 2 ^ gemIndex(c, r)) = 0 Or gameState = ST_TITLE Then
                            p = 1 + Sin(frameCount / 9) * .1
                            putCentered glow(GLOW_YELLOW), x + TILE / 2, y + TILE / 2, p, p
                            putCentered sprSwitchOn, x + TILE / 2, y + TILE / 2, 1, 1
                        Else
                            putCentered sprSwitchOff, x + TILE / 2, y + TILE / 2, 1, 1
                        End If
                    Case T_BARRIER
                        If (hero.openMask And 2 ^ gemIndex(c, r)) = 0 Or gameState = ST_TITLE Then
                            _PutImage (x + 2, y), sprBarrier
                        Else
                            Line (x + 2, y)-Step(TILE - 5, TILE - 1), _RGBA32(255, 210, 60, 40), B
                        End If
                    Case T_TELEIN, T_TELEOUT
                        p = 1 + Sin(frameCount / 7 + c) * .12
                        putCentered glow(GLOW_PURPLE), x + TILE / 2, y + TILE / 2 - 3, p * 1.1, p * 1.3
                        putCentered sprPortal, x + TILE / 2, y + TILE / 2 - 3, 1 + (p - 1) * .3, 1 + (p - 1) * .3
                    Case T_JET, T_WINGS, T_NORMAL
                        If (hero.gemMask And (2 ^ gemIndex(c, r))) = 0 Or gameState = ST_TITLE Then
                            drawModeOrb x + TILE / 2, y + TILE / 2 + Sin(frameCount / 12 + c) * 2, t
                        End If
                    Case T_GOAL
                        drawGoal x, y
                End Select
            End If
        Next
    Next
End Sub

' Lava or tar with open air above it: the surface of a pool.
Function liquidSurface& (c As Long, r As Long)
    Dim t As Long
    t = tileAt(c, r - 1)
    liquidSurface& = (t <> T_LAVA) And (t <> T_GROUND)
End Function

' The surface of a lava or tar pool, like the water: two slow sine waves
' across it, a bright crust on top, and now and then a bubble that swells and
' pops. Tar is darker, slower and lazier than lava. (Looks only; the tile is
' deadly from its top edge whatever the waves are doing.)
Sub drawLiquidTop (x As Single, y As Single, c As Long, r As Long)
    Dim i As Long, w As Long, px As Single, s As Single, top As Single
    Dim body As _Unsigned Long, crust As _Unsigned Long, glowC As _Unsigned Long, b As Long, period As Long
    Dim bx As Single, rad As Single
    If th.jungle Then
        body = _RGB32(34, 30, 36): crust = _RGB32(86, 80, 92): glowC = _RGB32(58, 52, 62): period = 200
    Else
        body = _RGB32(214, 64, 30): crust = _RGB32(255, 220, 120): glowC = _RGB32(255, 168, 48): period = 130
    End If
    For i = 0 To TILE - 1 Step 2
        w = 2: If i + w > TILE Then w = TILE - i
        px = c * TILE + i
        If th.jungle Then
            s = Sin(px / 16 + frameCount / 26) * 1.3 + Sin(px / 7 - frameCount / 37) * .5
        Else
            s = Sin(px / 13 + frameCount / 15) * 1.7 + Sin(px / 6 - frameCount / 10) * .6
        End If
        top = y + 3 + s
        Line (x + i, top)-(x + i + w - 1, y + LIQUID_TOP), body, BF
        Line (x + i, top + 2)-(x + i + w - 1, top + 3), glowC, BF
        Line (x + i, top)-(x + i + w - 1, top + 1), crust, BF
    Next
    ' a bubble: swells for 24 ticks, then pops into a few droplets
    b = (frameCount + Int(hash01(c, r) * 997)) Mod period
    bx = x + 5 + hash01(r, c) * 14
    If b < 24 Then
        rad = 1 + b / 24 * 3
        fillCircle bx, y + 3, rad, crust
        fillCircle bx, y + 3, rad - 1, glowC
    ElseIf b < 34 Then
        b = b - 24
        Line (bx - 2 - b * .5, y + 1 - b * .6 + b * b * .06)-Step(1, 1), crust, BF
        Line (bx + 1 + b * .5, y + 1 - b * .6 + b * b * .06)-Step(1, 1), crust, BF
        Line (bx, y - b * .9 + b * b * .08)-Step(1, 1), crust, BF
    End If
End Sub

' Mode pickups, each with its own shape so they read at a glance:
' jetpack = orange orb with a pack and flame, wings = green orb with wings
' sticking out, on foot = pale blue arrow pointing down at the ground.
Sub drawModeOrb (x As Single, y As Single, t As Long)
    Dim pulse As Single, f As Single
    pulse = 1 + Sin(frameCount / 8) * .1
    Select Case t
        Case T_JET
            putCentered glow(GLOW_ORANGE), x, y, pulse, pulse
            f = .75 + Rnd * .35 ' flicker
            _PutImage (x - 4, y + 3)-(x + 4, y + 3 + 13 * f), sprFlame
            putCentered sprJet, x, y, 1, 1
        Case T_WINGS
            putCentered glow(GLOW_GREEN), x, y, pulse, pulse
            f = .55 + .45 * (.5 + .5 * Sin(frameCount / 5)) ' flap
            _PutImage (x - 22, y - 1 - 8 * f)-(x - 5, y - 1 + 8 * f), sprWingL
            _PutImage (x + 5, y - 1 - 8 * f)-(x + 22, y - 1 + 8 * f), sprWingR
            putCentered sprWingsBody, x, y, 1, 1
        Case Else
            putCentered glow(GLOW_BLUE), x, y, pulse, pulse
            putCentered sprFoot, x, y, 1, 1
    End Select
End Sub

' Jaws start opening a little before they're dangerous and finish shutting
' after they're safe again, so they never look safer than they are.
Function crocFrame&
    Dim ph As Long
    ph = Int(hero.clock + .001) Mod CROC_PERIOD
    If ph >= CROC_OPEN_AT Then
        crocFrame& = 2
    ElseIf ph >= CROC_OPEN_AT - 10 Or ph < 6 Then
        crocFrame& = 1
    Else
        crocFrame& = 0
    End If
End Function

' Vines: a rope from the anchor to the tip, a few leaves, and the branch.
Sub drawVines (cx As Long, oy As Long)
    Dim v As Long, tx As Single, ty As Single, ax As Single, ay As Single, i As Long, f As Single
    Dim lx As Single, ly As Single, k As Single
    For v = 1 To nVines
        ax = vineAX(v) - cx: ay = vineAY(v) + oy
        If ax > -200 And ax < SW + 200 Then
            k = vinePhase(hero, v, Int(hero.clock + .001))
            If v = hero.vine Then k = hero.vineT
            tx = vineTipX(v, k) - cx: ty = vineTipY(v, k) + oy
            Line (ax - 1, ay)-(tx - 1, ty), _RGB32(60, 84, 30)
            Line (ax, ay)-(tx, ty), _RGB32(96, 128, 44)
            Line (ax + 1, ay)-(tx + 1, ty), _RGB32(76, 104, 36)
            For i = 1 To 4
                f = i / 5
                lx = ax + (tx - ax) * f: ly = ay + (ty - ay) * f
                If i Mod 2 = 0 Then
                    _PutImage (lx, ly - 4), sprLeaf
                Else
                    _PutImage (lx, ly - 4)-(lx - 11, ly + 3), sprLeaf
                End If
            Next
            _PutImage (ax - BOUGH_X, ay - BOUGH_Y), sprClump
        End If
    Next
End Sub

' Dotted line where the previous attempt ended, with its percentage.
Sub drawAttemptMark (cx As Long, oy As Long)
    Dim x As Single, y As Long, s As String
    If markX < 0 Then Exit Sub
    x = Int(markX - cx)
    If x < -40 Or x > SW + 40 Then Exit Sub
    For y = 30 To SH - 1 Step 10
        Line (x, y + oy)-Step(1, 5), _RGBA32(255, 255, 255, 150), BF
    Next
    s = LTrim$(Str$(markPct)) + "%"
    textAt s, x - _PrintWidth(s) / 2, 30 - 16 + oy, _RGBA32(255, 255, 255, 200)
End Sub

' Toggle spikes slide: they rise just before they become dangerous and sink
' just after they stop being dangerous, so what you see is never safer than
' what the physics does.
Sub drawToggleSpike (x As Single, y As Single, t As Long)
    Dim shift As Long
    shift = Int((1 - toggleVisual(t)) * 18)
    If shift < 18 Then _PutImage (x, y + shift)-(x + TILE - 1, y + TILE - 1), sprSpikeUp, 0, (0, 0)-(TILE - 1, TILE - 1 - shift)
    ' the base plate always shows; the spikes sink into it
    _PutImage (x, y + 20)-(x + TILE - 1, y + TILE - 1), sprSpikeUp, 0, (0, 20)-(TILE - 1, TILE - 1)
End Sub

Function toggleVisual! (t As Long)
    Const MOVE = 8
    Dim ph As Long, rel As Long, period As Long
    period = TOGGLE_TICKS * 2
    ph = Int(hero.clock + .001) Mod period
    If t = T_TOGGLEA Then rel = ph Else rel = (ph + TOGGLE_TICKS) Mod period
    If rel < TOGGLE_TICKS Then
        toggleVisual! = 1 ' dangerous
    ElseIf rel < TOGGLE_TICKS + MOVE Then
        toggleVisual! = 1 - (rel - TOGGLE_TICKS) / MOVE ' sinking, already safe
    ElseIf rel >= period - MOVE Then
        toggleVisual! = (rel - (period - MOVE)) / MOVE ' rising, not dangerous yet
    Else
        toggleVisual! = 0
    End If
End Function

' A brief four-point sparkle; age counts up, visible for the first 12.
Sub twinkle (x As Single, y As Single, age As Long)
    Dim a As Long, s As Single
    If age >= 12 Then Exit Sub
    s = Sin(age / 12 * 3.1416)
    a = 230 * s
    Line (x - 4 * s, y)-(x + 4 * s, y), _RGBA32(255, 255, 255, a)
    Line (x, y - 4 * s)-(x, y + 4 * s), _RGBA32(255, 255, 255, a)
End Sub

' Draw img centred on (x, y), scaled by sx, sy.
Sub putCentered (img As Long, x As Single, y As Single, sx As Single, sy As Single)
    Dim w As Single, h As Single
    w = _Width(img) * sx: h = _Height(img) * sy
    If w < 1 Or h < 1 Then Exit Sub
    _PutImage (x - w / 2, y - h / 2)-(x + w / 2 - 1, y + h / 2 - 1), img
End Sub

Sub drawGoal (x As Single, y As Single)
    Dim i As Long, w As Single, fy As Single
    Line (x + 2, y - 70)-Step(3, 70 + TILE - 1), _RGB32(240, 240, 240), BF
    Line (x + 2, y - 70)-Step(3, 70 + TILE - 1), _RGB32(60, 60, 80), B
    For i = 0 To 30
        fy = y - 68 + Sin(frameCount / 6 - i / 5) * 2
        If ((i \ 6) Mod 2) = 0 Then
            Line (x + 6 + i, fy)-Step(0, 9), _RGB32(30, 30, 40)
            Line (x + 6 + i, fy + 10)-Step(0, 9), _RGB32(250, 250, 250)
        Else
            Line (x + 6 + i, fy)-Step(0, 9), _RGB32(250, 250, 250)
            Line (x + 6 + i, fy + 10)-Step(0, 9), _RGB32(30, 30, 40)
        End If
    Next
End Sub

' vis < 1 is used by teleports (see below).
Sub drawHero (cx As Long, oy As Long, vis As Single)
    Dim f As Long, x As Single, y As Single, w As Single, h As Single, q As Long
    Dim sy As Single, r As Long, c As Long, sx1 As Single, sx2 As Single
    Dim bx As Single, gy As Single, fl As Single, fs As Long
    fs = 1
    If freeMove And hero.facing < 0 Then fs = -1

    ' shadow on the first floor below the hero
    sx1 = hero.x + 2: sx2 = hero.x + HERO_W - 2
    For r = Int((hero.y + HERO_H) / TILE) To ROWS - 1
        If r >= 0 Then
            c = Int((hero.x + HERO_W / 2) / TILE)
            If isSolid(hero, c, r) Or tileAt(c, r) = T_PLANK Then
                sy = r * TILE
                Line (sx1 - cx, sy + 2 + oy)-(sx2 - cx, sy + 4 + oy), _RGBA32(0, 0, 0, 60), BF
                Exit For
            End If
        End If
    Next

    If hero.vine > 0 Then
        f = 6 ' hanging on: arms-up pose
    ElseIf hero.grounded Then
        If gameState <> ST_PLAY Then
            f = 8
        ElseIf freeMove Then
            ' run cycle follows the distance walked; stand still = idle
            If Abs(hero.xv) < .4 Then f = 8 Else f = Int(hero.x / 16) Mod 6
        Else
            f = (frameCount \ 4) Mod 6
        End If
    ElseIf hero.yv < -1 Then
        f = 6
    Else
        f = 7
    End If
    q = Int(squash / .2 + .5) + HERO_SQ \ 2 ' squash > 0 = landing, < 0 = take-off
    If q < 0 Then q = 0
    If q > HERO_SQ - 1 Then q = HERO_SQ - 1

    ' bottom middle of the hero on screen; y = roughly the top of its head
    bx = hero.x + HERO_W / 2 - cx: gy = hero.y + HERO_H + oy
    x = bx - 10: y = gy - 21

    ' worn power-ups go behind the hero
    If vis >= 1 And hero.mode = MODE_JET Then
        If hero.thrust Then
            fl = .7 + Rnd * .4
            _PutImage (bx - 13 * fs, gy - 6)-(bx - 7 * fs, gy - 6 + 12 * fl), sprFlame
        End If
        _PutImage (bx - 15 * fs, gy - 19)-(bx - 7 * fs, gy - 6), sprPack
    ElseIf vis >= 1 And hero.mode = MODE_WINGS Then
        fl = .35 + .65 * (.5 + .5 * Sin(frameCount / 3)) ' flap
        _PutImage (bx - 20 * fs, gy - 15 - 7 * fl)-(bx - 4 * fs, gy - 15 + 7 * fl), sprWingL
    End If

    ' vis < 1 squeezes the hero into a thin, tall sliver (teleports)
    w = 28 * vis
    h = 28 * (1 + (1 - vis) * .8)
    ' facing left: swapping the x corners mirrors the image
    If w >= 1 Then _PutImage (bx - (w / 2 - .5) * fs, gy - h)-(bx + (w / 2 - .5) * fs, gy - 1), heroImg(f * HERO_SQ + q)
    If vis < 1 Then Exit Sub

    ' free move: a bobbing arrow when standing in a portal you can enter
    If freeMove Then
        c = Int((hero.x + HERO_W / 2) / TILE): r = Int((hero.y + HERO_H / 2) / TILE)
        If tileAt(c, r) = T_TELEIN Or tileAt(c, r) = T_TELEOUT Then
            If teleCol(c, r) >= 0 Then
                sy = y - 16 + Sin(frameCount / 6) * 2
                fillTri bx, sy, 5, sy + 5, _RGB32(230, 170, 255)
                Line (bx - 1.5, sy + 5)-Step(3, 4), _RGB32(230, 170, 255), BF
            End If
        End If
    End If

    ' spare air jumps
    For c = 1 To hero.airJumps
        putCentered sprGem, bx - (hero.airJumps - 1) * 6 + (c - 1) * 12, y - 6, .45, .45
    Next
    w = 20
    ' fuel gauge: a bar that stretches past full when you carry extra
    If hero.mode = MODE_JET Then
        Line (x + w / 2 - 13, y - 18)-Step(26 * fuelBarScale(hero.fuel), 4), _RGB32(50, 30, 24), BF
        Line (x + w / 2 - 12, y - 17)-Step(26 * fuelBarScale(hero.fuel) - 2, 2), _RGB32(70, 44, 36), BF
        If hero.fuel * 26 / JET_FUEL > 2 Then Line (x + w / 2 - 12, y - 17)-Step(26 * hero.fuel / JET_FUEL - 2, 2), _RGB32(255, 160, 60), BF
    End If
    ' wings timer: a shrinking bar that blinks near the end
    If hero.mode = MODE_WINGS Then
        If hero.wingTicks > 40 Or (frameCount \ 4) Mod 2 = 0 Then
            Line (x + w / 2 - 13, y - 18)-Step(26, 4), _RGB32(30, 50, 40), BF
            Line (x + w / 2 - 12, y - 17)-Step(24 * hero.wingTicks / WING_TICKS, 2), _RGB32(150, 250, 170), BF
        End If
    End If
End Sub

' A column of light on the hero; strength 0..1.
Sub drawBeam (cx As Long, oy As Long, strength As Single)
    Dim x As Single, top As Single, bot As Single
    x = hero.x + HERO_W / 2 - cx
    bot = hero.y + HERO_H + oy
    top = bot - 90
    Line (x - 9, top)-(x + 9, bot), _RGBA32(220, 120, 255, 70 * strength), BF
    Line (x - 4, top)-(x + 4, bot), _RGBA32(255, 230, 255, 120 * strength), BF
End Sub

Sub drawPopup (cx As Long)
    Dim x As Single, y As Single, a As Long, age As Long, w As Single
    age = POP_TICKS - popLife
    a = 255
    If age < 6 Then a = 255 * age / 6
    If popLife < 25 Then a = 255 * popLife / 25
    x = hero.x + HERO_W / 2 - cx
    y = hero.y - 40 - age * .3
    If y < 60 Then y = 60
    w = _PrintWidth(popHint) / 2 + 4
    If w < _PrintWidth(popText) + 4 Then w = _PrintWidth(popText) + 4
    If x < w Then x = w
    If x > SW - w Then x = SW - w
    bigText popText, x, y, 2, _RGBA32(_Red32(popColor), _Green32(popColor), _Blue32(popColor), a)
    If popHint <> "" Then
        putText popHint, x - _PrintWidth(popHint) / 2 + 1, y + 19, 1, _RGBA32(30, 26, 46, a)
        putText popHint, x - _PrintWidth(popHint) / 2, y + 18, 1, _RGBA32(255, 255, 255, a)
    End If
End Sub

Sub sparkle (x As Single, y As Single)
    spawnParticle x + (Rnd - .5) * 16, y + (Rnd - .5) * 24, (Rnd - .5) * .6, -Rnd * 1.5 - .5, 18, 2, _RGB32(240, 190, 255)
End Sub

'=============================================================================
' SPRITES
' Spikes and pickups are drawn once at startup into small images with smooth
' edges: every pixel measures how far it is from each shape's edge and the
' layers are blended by hand. Each frame then only needs _PutImage.
'=============================================================================

Sub initSprites
    Dim k As Long
    For k = 0 To 2
        sprCroc(k) = makeCroc(k / 2)
        rawWrites sprCroc(k), FALSE
    Next
    sprLeaf = makeLeaf: rawWrites sprLeaf, FALSE
    sprClump = makeClump: rawWrites sprClump, FALSE
    sprSpikeUp = makeSpike(FALSE)
    sprSpikeDown = makeSpike(TRUE)
    sprGem = makeGem
    sprJet = makeJetOrb
    sprFlame = makeFlame
    sprWingsBody = makeWingsOrb
    sprWingL = makeWing(FALSE)
    sprWingR = makeWing(TRUE)
    sprFoot = makeFootOrb
    sprSwitchOn = makeSwitch(TRUE)
    sprSwitchOff = makeSwitch(FALSE)
    sprPortal = makePortal
    sprBarrier = makeBarrier
    sprFuel = makeFuel
    glow(GLOW_CYAN) = makeGlow(_RGB32(120, 230, 255))
    glow(GLOW_ORANGE) = makeGlow(_RGB32(255, 150, 60))
    glow(GLOW_GREEN) = makeGlow(_RGB32(130, 240, 150))
    glow(GLOW_BLUE) = makeGlow(_RGB32(170, 210, 255))
    glow(GLOW_PURPLE) = makeGlow(_RGB32(210, 120, 255))
    glow(GLOW_YELLOW) = makeGlow(_RGB32(255, 220, 90))

    Dim i As Long
    rawWrites sprSpikeUp, FALSE: rawWrites sprSpikeDown, FALSE: rawWrites sprGem, FALSE
    rawWrites sprJet, FALSE: rawWrites sprFlame, FALSE: rawWrites sprWingsBody, FALSE
    rawWrites sprWingL, FALSE: rawWrites sprWingR, FALSE: rawWrites sprFoot, FALSE
    rawWrites sprSwitchOn, FALSE: rawWrites sprSwitchOff, FALSE: rawWrites sprPortal, FALSE: rawWrites sprBarrier, FALSE: rawWrites sprFuel, FALSE
    For i = 1 To 6: rawWrites glow(i), FALSE: Next
End Sub

' QB64 blends semi-transparent pixels into an empty image as if it were
' black, which leaves dark fringes on soft edges, so while building an image
' we write pixels as-is, then switch blending back on (QB64 uses the source
' image's setting when it _PutImage's it). The browser canvas in QBJS gets
' this right by itself, so QBJS skips it.
Sub rawWrites (img As Long, raw As Long)
$If WEB Then
$Else
    If raw Then _DontBlend img Else _Blend img
$End If
End Sub

Function newSprite& (w As Long, h As Long)
    Dim img As Long
    img = _NewImage(w, h, 32)
    rawWrites img, TRUE
    _Dest img
    newSprite& = img
End Function

'--- per-pixel blending: pxBegin, then pxLayer from back to front, then pxEnd

Sub pxBegin
    accR = 0: accG = 0: accB = 0: accA = 0
End Sub

' Paint colour c over the current pixel with coverage cv (0..1).
Sub pxLayer (c As _Unsigned Long, cv As Single)
    Dim a As Single, keep As Single, outA As Single
    If cv <= 0 Then Exit Sub
    a = alpha32(c) / 255 * cv
    If a > 1 Then a = 1
    keep = accA * (1 - a)
    outA = a + keep
    If outA <= 0 Then Exit Sub
    accR = (_Red32(c) * a + accR * keep) / outA
    accG = (_Green32(c) * a + accG * keep) / outA
    accB = (_Blue32(c) * a + accB * keep) / outA
    accA = outA
End Sub

Sub pxEnd (x As Long, y As Long)
    If accA > .004 Then PSet (x, y), _RGBA32(accR, accG, accB, accA * 255)
End Sub

' How much of a pixel a shape covers, from the signed distance to its edge
' (negative = inside). This one-pixel ramp is what makes the edges smooth.
Function cov! (d As Single)
    If d <= -.5 Then
        cov! = 1
    ElseIf d >= .5 Then
        cov! = 0
    Else
        cov! = .5 - d
    End If
End Function

'--- signed distances to shapes

Function sdCircle! (px As Single, py As Single, cx As Single, cy As Single, r As Single)
    sdCircle! = Sqr((px - cx) * (px - cx) + (py - cy) * (py - cy)) - r
End Function

' Box centred on (cx, cy), half sizes hw x hh, corners rounded by rad.
Function sdBox! (px As Single, py As Single, cx As Single, cy As Single, hw As Single, hh As Single, rad As Single)
    Dim qx As Single, qy As Single, ox As Single, oy As Single, m As Single
    qx = Abs(px - cx) - hw + rad: qy = Abs(py - cy) - hh + rad
    ox = qx: oy = qy
    If ox < 0 Then ox = 0
    If oy < 0 Then oy = 0
    m = qx
    If qy > m Then m = qy
    If m > 0 Then m = 0
    sdBox! = Sqr(ox * ox + oy * oy) + m - rad
End Function

' Ellipse starting at (ax, ay) along angle ang, length ln, half-thickness th.
Function sdFeather! (px As Single, py As Single, ax As Single, ay As Single, ang As Single, ln As Single, th As Single)
    Dim dx As Single, dy As Single, mx As Single, my As Single, u As Single, v As Single
    dx = Cos(ang): dy = Sin(ang)
    mx = px - (ax + dx * ln / 2): my = py - (ay + dy * ln / 2)
    u = (mx * dx + my * dy) / (ln / 2)
    v = (-mx * dy + my * dx) / th
    sdFeather! = (Sqr(u * u + v * v) - 1) * th
End Function

Sub setPoly3 (x1 As Single, y1 As Single, x2 As Single, y2 As Single, x3 As Single, y3 As Single)
    polyN = 3
    polyX(1) = x1: polyY(1) = y1: polyX(2) = x2: polyY(2) = y2: polyX(3) = x3: polyY(3) = y3
    fixPolyOrient
End Sub

Sub setPoly5 (x1 As Single, y1 As Single, x2 As Single, y2 As Single, x3 As Single, y3 As Single, x4 As Single, y4 As Single, x5 As Single, y5 As Single)
    polyN = 5
    polyX(1) = x1: polyY(1) = y1: polyX(2) = x2: polyY(2) = y2: polyX(3) = x3: polyY(3) = y3
    polyX(4) = x4: polyY(4) = y4: polyX(5) = x5: polyY(5) = y5
    fixPolyOrient
End Sub

' Make sdPoly negative inside, whichever way round the points were given.
Sub fixPolyOrient
    Dim i As Long, cx As Single, cy As Single
    For i = 1 To polyN
        cx = cx + polyX(i): cy = cy + polyY(i)
    Next
    polyOrient = 1
    If sdPoly(cx / polyN, cy / polyN) > 0 Then polyOrient = -1
End Sub

' Distance to a convex polygon (exact inside and near the edges, which is
' all the edge smoothing needs).
Function sdPoly! (px As Single, py As Single)
    Dim i As Long, j As Long, ex As Single, ey As Single, d As Single, m As Single
    m = -1000000000
    For i = 1 To polyN
        j = i Mod polyN + 1
        ex = polyX(j) - polyX(i): ey = polyY(j) - polyY(i)
        d = ((px - polyX(i)) * ey - (py - polyY(i)) * ex) / Sqr(ex * ex + ey * ey) * polyOrient
        If d > m Then m = d
    Next
    sdPoly! = m
End Function

' Shading for a ball of radius r centred at (cx, cy), lit from the top left.
Function sphereShade~& (c As _Unsigned Long, px As Single, py As Single, cx As Single, cy As Single, r As Single)
    Dim nx As Single, ny As Single, t As Single, lam As Single, f As Single, spec As Single
    Dim rr As Single, gg As Single, bb As Single
    nx = (px - cx) / r: ny = (py - cy) / r
    t = 1 - nx * nx - ny * ny
    If t < 0 Then t = 0
    lam = -.45 * nx - .55 * ny + .7 * Sqr(t)
    If lam < 0 Then lam = 0
    f = .5 + .65 * lam
    spec = (lam ^ 20) * .8
    rr = _Red32(c) * f + 255 * spec: gg = _Green32(c) * f + 255 * spec: bb = _Blue32(c) * f + 255 * spec
    If rr > 255 Then rr = 255
    If gg > 255 Then gg = 255
    If bb > 255 Then bb = 255
    sphereShade~& = _RGB32(rr, gg, bb)
End Function

'--- the sprites

' Steel spikes for one tile: a big spike with two small ones behind it, on a
' base plate, lit from the left. flip = the hanging version.
Function makeSpike& (flip As Long)
    Dim img As Long, px As Long, py As Long, X As Single, Y As Single, d As Single, t As Single
    Dim ink As _Unsigned Long, lit As _Unsigned Long, shd As _Unsigned Long
    ink = _RGB32(36, 36, 52)
    img = newSprite(TILE, TILE)
    For py = 0 To TILE - 1
        For px = 0 To TILE - 1
            X = px + .5: Y = py + .5
            If flip Then Y = TILE - Y
            t = (Y - 4) / 18
            lit = mixColor(_RGB32(238, 242, 250), _RGB32(170, 176, 198), t)
            shd = mixColor(_RGB32(150, 156, 180), _RGB32(92, 96, 120), t)
            pxBegin
            setPoly3 5, 11, 1, 22.5, 9.5, 22.5
            d = sdPoly(X, Y)
            pxLayer ink, cov(d)
            If X < 5 Then pxLayer lit, cov(d + 1) Else pxLayer shd, cov(d + 1)
            setPoly3 20, 11, 15.5, 22.5, 24, 22.5
            d = sdPoly(X, Y)
            pxLayer ink, cov(d)
            If X < 20 Then pxLayer lit, cov(d + 1) Else pxLayer shd, cov(d + 1)
            setPoly3 12.5, 2.5, 4.5, 22.5, 20.5, 22.5
            d = sdPoly(X, Y)
            pxLayer ink, cov(d)
            If X < 12.5 Then pxLayer lit, cov(d + 1) Else pxLayer shd, cov(d + 1)
            pxLayer _RGBA32(255, 255, 255, 70), cov(Abs(X - 12.5) - .4) * cov(d + 2)
            pxLayer _RGBA32(255, 255, 255, 230), cov(sdCircle(X, Y, 11.3, 8.5, .9))
            d = sdBox(X, Y, 12.5, 23, 11.5, 2, 1)
            pxLayer ink, cov(d)
            pxLayer mixColor(_RGB32(128, 134, 156), _RGB32(76, 80, 100), (Y - 21.5) / 3), cov(d + 1)
            pxEnd px, py
        Next
    Next
    _Dest 0
    makeSpike& = img
End Function

' Cut diamond: lighter crown facets on top, darker pavilion below.
Function makeGem&
    Dim img As Long, px As Long, py As Long, X As Single, Y As Single, d As Single
    Dim c As _Unsigned Long, xl As Single, xr As Single
    img = newSprite(20, 24)
    For py = 0 To 23
        For px = 0 To 19
            X = px + .5: Y = py + .5
            pxBegin
            setPoly5 6, 2, 14, 2, 19, 8.5, 10, 22.5, 1, 8.5
            d = sdPoly(X, Y)
            pxLayer _RGB32(24, 64, 112), cov(d)
            If Y < 8.5 Then
                If X < 6.5 Then
                    c = _RGB32(214, 250, 255)
                ElseIf X > 13.5 Then
                    c = _RGB32(112, 202, 246)
                Else
                    c = _RGB32(172, 238, 255)
                End If
            Else
                xl = 5 + (Y - 8.5) / 14 * 5: xr = 15 - (Y - 8.5) / 14 * 5
                If X < xl Then
                    c = _RGB32(96, 192, 242)
                ElseIf X > xr Then
                    c = _RGB32(40, 132, 210)
                Else
                    c = _RGB32(70, 166, 232)
                End If
            End If
            pxLayer c, cov(d + 1)
            pxLayer _RGBA32(255, 255, 255, 110), cov(Abs(Y - 8.5) - .5) * cov(d + 1.5)
            pxLayer _RGBA32(255, 255, 255, 240), cov(sdCircle(X, Y, 6.5, 5, 1.2))
            pxEnd px, py
        Next
    Next
    _Dest 0
    makeGem& = img
End Function

' Soft round glow, strongest in the middle.
Function makeGlow& (c As _Unsigned Long)
    Dim img As Long, px As Long, py As Long, d As Single
    img = newSprite(48, 48)
    For py = 0 To 47
        For px = 0 To 47
            d = Sqr((px + .5 - 24) * (px + .5 - 24) + (py + .5 - 24) * (py + .5 - 24)) / 24
            If d < 1 Then
                pxBegin
                pxLayer c, (1 - d) * (1 - d) * .5
                pxEnd px, py
            End If
        Next
    Next
    _Dest 0
    makeGlow& = img
End Function

Function makeJetOrb&
    Dim img As Long, px As Long, py As Long, X As Single, Y As Single, d As Single
    img = newSprite(24, 24)
    For py = 0 To 23
        For px = 0 To 23
            X = px + .5: Y = py + .5
            pxBegin
            d = sdCircle(X, Y, 12, 12, 9.5)
            pxLayer _RGB32(96, 40, 18), cov(d)
            pxLayer sphereShade(_RGB32(255, 138, 48), X, Y, 12, 12, 9.5), cov(d + 1)
            d = sdBox(X, Y, 12, 11, 3.5, 4.5, 1.5)
            pxLayer _RGB32(40, 40, 58), cov(d)
            pxLayer mixColor(_RGB32(200, 202, 220), _RGB32(110, 112, 134), (X - 8.5) / 7), cov(d + 1)
            d = sdBox(X, Y, 12, 16.5, 2, 1.2, .5)
            pxLayer _RGB32(40, 40, 58), cov(d)
            pxLayer _RGB32(90, 92, 112), cov(d + 1)
            pxEnd px, py
        Next
    Next
    _Dest 0
    makeJetOrb& = img
End Function

' Crocodile head, two tiles long (CC in the level), snout to the left: only
' the jaws are above the water, the neck goes straight down, so what looks
' like something to stand on is exactly the solid part. The tiles are at
' x 2..51 of the image and their top (where the hero stands) at y 20; the
' 8 rows above the drawing coordinates leave room for the snout to open.
' The head (right tile, with the eye) never moves: it's a safe spot. The
' snout (left tile) opens at a hinge on the tile boundary.
' openAmt 0 = jaws shut, 1 = wide open.
Function makeCroc& (openAmt As Single)
    Dim img As Long, px As Long, py As Long, X As Single, Y As Single, d As Single, d2 As Single
    Dim ux As Single, uy As Single, ang As Single, ca As Single, sa As Single, i As Long
    Dim ink As _Unsigned Long, grn As _Unsigned Long, lit As _Unsigned Long, belly As _Unsigned Long
    Dim tipX As Single, tipY As Single, top As Single
    Const HX = 28, HY = 21 ' snout hinge, where the snout meets the head
    ink = _RGB32(22, 50, 30): grn = _RGB32(68, 140, 64): lit = _RGB32(120, 184, 92): belly = _RGB32(178, 204, 120)
    ' (ux, uy) below maps a pixel into the upper snout's own frame, so a
    ' negative sa turns the drawn snout tip-up
    ang = .5 * openAmt
    ca = Cos(-ang): sa = Sin(-ang)
    ' where the upper snout's tip ends up, for the inside of the mouth
    tipX = HX + (4 - HX) * ca + (20.8 - HY) * sa
    tipY = HY - (4 - HX) * sa + (20.8 - HY) * ca
    img = newSprite(56, 60)
    For py = 0 To 59
        For px = 0 To 55
            X = px + .5: Y = py + .5 - 8
            ux = HX + (X - HX) * ca - (Y - HY) * sa
            uy = HY + (X - HX) * sa + (Y - HY) * ca
            pxBegin
            ' neck, going down into the water, in shadow under the head
            d = sdBox(X, Y, 40, 40, 9, 16, 6)
            pxLayer ink, cov(d): pxLayer mixColor(grn, _RGB32(30, 70, 40), (Y - 24) / 20), cov(d + 1.2)
            ' inside of the mouth, seen when open
            If openAmt > 0 Then
                setPoly3 HX + 1, HY, 4, 21.5, tipX, tipY
                d = sdPoly(X, Y)
                pxLayer _RGB32(120, 30, 50), cov(d): pxLayer _RGB32(222, 96, 110), cov(d + 1)
            End If
            ' lower jaw, the full length
            d = sdBox(X, Y, 27, 23.5, 24, 3.2, 2.8)
            pxLayer ink, cov(d): pxLayer belly, cov(d + 1.1)
            For i = 0 To 5 ' lower teeth
                setPoly3 5.5 + i * 4.3, 21, 8.5 + i * 4.3, 21, 7 + i * 4.3, 18.6 - openAmt
                pxLayer _RGB32(250, 250, 236), cov(sdPoly(X, Y))
            Next
            ' head (still) and upper snout (rotated) as one shape, so there's
            ' no seam between them while shut
            ' (each runs into the other, so neither's rounded end shows at the
            ' joint; past the hinge the snout dips down inside the head)
            d = sdBox(X, Y, 38, 16.6, 14, 4.8, 4)
            d2 = sdBox(ux, uy, 20, 16.6, 16, 4.8, 4)
            If d2 < d Then d = d2: top = uy Else top = Y
            pxLayer ink, cov(d): pxLayer mixColor(lit, grn, (top - 12) / 8), cov(d + 1.1)
            For i = 0 To 5 ' upper teeth
                setPoly3 4 + i * 4.3, 20.8, 7 + i * 4.3, 20.8, 5.5 + i * 4.3, 23.4
                pxLayer _RGB32(250, 250, 236), cov(sdPoly(ux, uy))
            Next
            For i = 0 To 2 ' scales along the top of the snout
                pxLayer _RGBA32(22, 50, 30, 90), cov(sdCircle(ux, uy, 12 + i * 6, 14, 1))
            Next
            pxLayer _RGBA32(22, 50, 30, 90), cov(sdCircle(X, Y, 32, 14, 1))
            d = sdCircle(ux, uy, 5, 12.8, 1.8) ' nostril bump
            pxLayer ink, cov(d): pxLayer lit, cov(d + 1)
            ' eye bump on the head
            d = sdCircle(X, Y, 42, 11.5, 3.8)
            pxLayer ink, cov(d): pxLayer _RGB32(242, 214, 80), cov(d + 1)
            pxLayer ink, cov(sdBox(X, Y, 42.5, 11.5, .7, 2.3, .5))
            pxEnd px, py
        Next
    Next
    _Dest 0
    makeCroc& = img
End Function

' A leaf for the vines.
Function makeLeaf&
    Dim img As Long, px As Long, py As Long, X As Single, Y As Single, d As Single
    img = newSprite(12, 8)
    For py = 0 To 7
        For px = 0 To 11
            X = px + .5: Y = py + .5
            pxBegin
            d = sdFeather(X, Y, .5, 4, 0, 11, 3.3)
            pxLayer _RGB32(30, 76, 30), cov(d)
            pxLayer mixColor(_RGB32(120, 200, 80), _RGB32(56, 130, 48), Y / 8), cov(d + 1)
            pxLayer _RGBA32(30, 76, 30, 160), cov(Abs(Y - 4) - .4) * cov(d + 1.5)
            pxEnd px, py
        Next
    Next
    _Dest 0
    makeLeaf& = img
End Function

' The leafy branch a vine hangs from.
' The branch a vine hangs from: a bough coming down out of the canopy
' (above the top of the screen) to a knot at the anchor, with a cluster of
' leaves at the knot and more up where it meets the canopy. The anchor is
' at (BOUGH_X, BOUGH_Y) in the image.
Function makeClump&
    Dim img As Long, px As Long, py As Long, X As Single, Y As Single, d As Single, i As Long
    Dim t As Single, w As Single, cx As Single, cy As Single, ang As Single, nl As Long
    Dim lx(1 To 48) As Single, ly(1 To 48) As Single, la(1 To 48) As Single, ll(1 To 48) As Single
    Dim lc(1 To 48) As _Unsigned Long
    Dim ink As _Unsigned Long, bark As _Unsigned Long, barkLit As _Unsigned Long
    ink = _RGB32(20, 44, 24): bark = _RGB32(84, 58, 36): barkLit = _RGB32(132, 98, 62)
    nl = 48
    For i = 1 To nl
        If i <= 16 Then ' around the knot, leaving the anchor itself clear
            cx = BOUGH_X + 4: cy = BOUGH_Y - 10
            ang = (i / 16) * 6.283 + hash01(i, 61) * .5
            If Sin(ang) > .55 Then ang = ang + 1.6
            lx(i) = cx + Cos(ang) * 4: ly(i) = cy + Sin(ang) * 3
            ll(i) = 11 + hash01(i, 63) * 5
        ElseIf i <= 40 Then ' up where the bough meets the canopy, hanging down
            cy = 66 + hash01(i, 67) * 50
            lx(i) = boughX(cy) + (hash01(i, 65) - .5) * 44: ly(i) = cy
            ang = 1.57 + (hash01(i, 69) - .5) * 3.2
            ll(i) = 13 + hash01(i, 71) * 7
        Else ' pairs along the middle of the bough
            cy = 125 + (i - 41) * 7
            lx(i) = boughX(cy): ly(i) = cy
            If i Mod 2 Then ang = .5 + hash01(i, 69) * .5 Else ang = 2.6 - hash01(i, 69) * .5
            ll(i) = 10 + hash01(i, 71) * 4
        End If
        la(i) = ang
        lc(i) = mixColor(_RGB32(46, 110, 44), _RGB32(104, 178, 74), hash01(i, 73) * .6 + (i Mod 3) * .2)
    Next
    img = newSprite(110, 200)
    For py = 0 To 199
        For px = 0 To 109
            X = px + .5: Y = py + .5
            pxBegin
            ' the bough, tapering from the canopy down to the knot
            If Y <= BOUGH_Y + 2 Then
                cx = boughX(Y): w = 8 - 4 * Y / BOUGH_Y
                d = Abs(X - cx) - w
                If Y > BOUGH_Y - 2 Then d = sdCircle(X, Y, BOUGH_X, BOUGH_Y - 2, 4.5) ' the knot
                pxLayer ink, cov(d)
                pxLayer mixColor(barkLit, bark, (X - cx + w) / (2 * w)), cov(d + 1.2)
            End If
            For i = 1 To nl
                d = sdFeather(X, Y, lx(i), ly(i), la(i), ll(i), 3.6)
                If d < 2 Then
                    pxLayer ink, cov(d)
                    pxLayer lc(i), cov(d + 1)
                    ' midrib
                    pxLayer _RGBA32(30, 70, 34, 110), cov(Abs(sdFeather(X, Y, lx(i), ly(i), la(i), ll(i), .6)) - .1)
                End If
            Next
            pxEnd px, py
        Next
    Next
    _Dest 0
    makeClump& = img
End Function

' Centre line of the vine branch at height y of its sprite: it leans in from
' the right and bends a little on the way down to the knot.
Function boughX! (y As Single)
    Dim t As Single
    t = y / BOUGH_Y
    If t < 0 Then t = 0
    If t > 1 Then t = 1
    boughX! = 80 + (BOUGH_X - 80) * t + Sin(t * 3.1416) * 10
End Function

